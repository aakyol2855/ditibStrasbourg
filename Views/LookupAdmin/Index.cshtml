@model IEnumerable<DitibStasbourg.Models.LookupType>
@{
    ViewData["Title"] = "Dinamik Tanımlamalar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Tanımlama Yönetimi <help-icon topic-id="3" title="Tanımlama Sistemi"></help-icon></h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTypeModal">
        <i class="bi bi-plus-lg"></i> Yeni Tür Ekle
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="bg-light">
                <tr>
                    <th>ID</th>
                    <th>Tür Adı</th>
                    <th>Kod</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong>@item.Name</strong></td>
                        <td><span class="badge bg-secondary">@item.Code</span></td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Pasif</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Values" asp-route-typeId="@item.Id" class="btn btn-sm btn-info text-white">Değerler</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="CreateType" method="post" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Tür Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Tür Adı</label>
                    <input type="text" name="Name" class="form-control" required placeholder="Örn: Başvuru Türü">
                </div>
                <div class="mb-3">
                    <label class="form-label">Kod</label>
                    <input type="text" name="Code" class="form-control" required placeholder="Örn: BASVURU_TURU">
                    <div class="form-text">Kod benzersiz olmalı ve boşluk içermemelidir.</div>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked>
                    <label class="form-check-label">Aktif Mi?</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>
