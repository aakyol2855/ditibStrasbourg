@model DitibStasbourg.Models.LookupType
@{
    ViewData["Title"] = Model.Name + " Değerleri";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>@Model.Name <small class="text-muted fs-5">Değerleri</small></h2>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2"><i class="bi bi-arrow-left"></i> Türlere Dön</a>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createValueModal">
        <i class="bi bi-plus-lg"></i> Yeni Değer Ekle
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="bg-light">
                <tr>
                    <th>Sıra</th>
                    <th>Değer Adı</th>
                    <th>Opsiyonel Veri</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Values.OrderBy(v => v.SortOrder))
                {
                    <tr>
                        <td>@item.SortOrder</td>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Value</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Pasif</span>
                            }
                        </td>
                    </tr>
                }
                @if(!Model.Values.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Henüz değer eklenmemiş.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createValueModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="CreateValue" method="post" class="modal-content">
            <input type="hidden" name="LookupTypeId" value="@Model.Id" />
            <div class="modal-header">
                <h5 class="modal-title">Yeni Değer Ekle (@Model.Name)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Değer Adı</label>
                    <input type="text" name="Name" class="form-control" required placeholder="Örn: Bağış">
                </div>
                <div class="mb-3">
                    <label class="form-label">Opsiyonel Veri (Value/Slug)</label>
                    <input type="text" name="Value" class="form-control" placeholder="Örn: BAGIS">
                </div>
                <div class="mb-3">
                    <label class="form-label">Sıra No</label>
                    <input type="number" name="SortOrder" class="form-control" value="0">
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked>
                    <label class="form-check-label">Aktif Mi?</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>
