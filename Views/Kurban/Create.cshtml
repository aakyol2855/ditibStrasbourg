@model DitibStasbourg.Models.Kurbanlik

<!-- Developed by Abdulvahab Akyol (aakyol) -->
@{
    ViewData["Title"] = "Yeni Kurbanlık Ekle";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-lg">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold">Yeni Kurbanlık Kaydı</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="mb-3">
                        <label asp-for="TagNumber" class="form-label fw-bold">Küpe Numarası</label>
                        <input asp-for="TagNumber" class="form-control" placeholder="Örn: TR-00123" />
                        <span asp-validation-for="TagNumber" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Species" class="form-label fw-bold">Tür</label>
                            <select asp-for="Species" class="form-select">
                                <option value="Büyükbaş">Büyükbaş</option>
                                <option value="Küçükbaş">Küçükbaş</option>
                            </select>
                            <span asp-validation-for="Species" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TotalShares" class="form-label fw-bold">Toplam Hisse</label>
                            <input asp-for="TotalShares" class="form-control" type="number" value="7" />
                            <span asp-validation-for="TotalShares" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Weight" class="form-label fw-bold">Tahmini Kilo (kg)</label>
                            <input asp-for="Weight" class="form-control" />
                            <span asp-validation-for="Weight" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-bold">Alış Fiyatı</label>
                            <input asp-for="Price" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-3">
                        <a asp-action="Index" class="btn btn-light px-4">İptal</a>
                        <button type="submit" class="btn btn-primary px-5">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
