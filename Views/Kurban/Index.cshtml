@model IEnumerable<DitibStasbourg.Models.KurbanCampaignRecord>
@{
    ViewData["Title"] = "Kurban Kampanya Analiz Paneli";
}

<style type="text/css">
    .hover-up {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-up:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    }
    .bg-gradient-blue {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
    }
    .bg-gradient-teal {
        background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
    }
    .bg-gradient-rose {
        background: linear-gradient(135deg, #9f1239 0%, #fda4af 100%);
    }
    .card-glass {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(226, 232, 240, 0.8);
    }
</style>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Kurban Kampanya Analiz Paneli</h2>
            <p class="text-muted mb-0 small">Kurban organizasyonu bölge, cami ve FYS sorumlu kırılımlı finansal analiz dashboardu.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("KurbanOnayYetkilisi"))
            {
                <a asp-action="PendingApprovals" class="btn btn-warning btn-sm shadow-sm me-2">
                    <i class="bi bi-shield-check me-1"></i>Onay Bekleyenler
                </a>
            }
            <a asp-action="Create" class="btn btn-primary btn-sm shadow-sm me-2">
                <i class="bi bi-plus-lg me-1"></i>Yeni Kampanya Girişi Ekle
            </a>
            <label for="yearSelector" class="fw-semibold text-secondary mb-0 me-1 small">Kampanya Yılı:</label>
            <select id="yearSelector" class="form-select form-select-sm shadow-sm" style="width: 120px;" onchange="filterYear(this.value)">
                <option value="2026" selected>2026</option>
                <option value="2025">2025</option>
                <option value="2024">2024</option>
            </select>
        </div>
    </div>

    <!-- Aggregate Analytics Cards -->
    <div class="row g-3 mb-4">
        <!-- Toplam Kurban Sayısı -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 hover-up bg-gradient-blue text-white" style="border-radius: 1.25rem;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-white-50 fw-semibold text-uppercase tracking-wider small">Toplam Kurban Sayısı (Diğer + TR)</span>
                        <i class="bi bi-gift fs-3 text-white-50"></i>
                    </div>
                    <h2 class="fw-bold mb-1" id="statTotalCount">0</h2>
                    <p class="mb-0 text-white-50 small">
                        Diğer: <span id="statDigerCount" class="fw-bold text-white">0</span> | 
                        TR: <span id="statTrCount" class="fw-bold text-white">0</span>
                    </p>
                </div>
            </div>
        </div>
        <!-- Toplam Toplanan Miktar -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 hover-up bg-gradient-teal text-white" style="border-radius: 1.25rem;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-white-50 fw-semibold text-uppercase tracking-wider small">Toplam Toplanan Miktar</span>
                        <i class="bi bi-wallet2 fs-3 text-white-50"></i>
                    </div>
                    <h2 class="fw-bold mb-1" id="statTotalAmount">0.00 €</h2>
                    <p class="mb-0 text-white-50 small">
                        Diğer Miktar: <span id="statDigerAmount" class="fw-bold text-white">0.00 €</span> | 
                        TR Miktar: <span id="statTrAmount" class="fw-bold text-white">0.00 €</span>
                    </p>
                </div>
            </div>
        </div>
        <!-- Kalan Toplam Ödeme -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 hover-up bg-gradient-rose text-white" style="border-radius: 1.25rem;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-white-50 fw-semibold text-uppercase tracking-wider small">Kalan Toplam Ödeme</span>
                        <i class="bi bi-hourglass-split fs-3 text-white-50"></i>
                    </div>
                    <h2 class="fw-bold mb-1" id="statRemainingAmount">0.00 €</h2>
                    <p class="mb-0 text-white-50 small">Mutabakat bekleyen toplam tutar.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Campaign Data Grid -->
        <div class="col-xl-9 col-lg-8">
            <div class="card card-glass shadow-sm border-0" style="border-radius: 1.25rem; overflow: hidden;">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold text-dark"><i class="bi bi-list-stars text-primary me-2"></i>Kampanya Detay Matrisi</h5>
                    <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2" id="gridYearBadge">Yıl: 2026</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-center">
                        <thead class="table-light text-uppercase font-monospace" style="font-size: 0.8rem;">
                            <tr>
                                <th class="px-3 text-start kurban-sortable" data-sort-order="asc" style="cursor: pointer;">Bölge <i class="bi bi-arrow-down-up ms-1 small"></i></th>
                                <th class="text-start kurban-sortable" data-sort-order="asc" style="cursor: pointer;">Cami <i class="bi bi-arrow-down-up ms-1 small"></i></th>
                                <th class="kurban-sortable" data-sort-order="asc" style="cursor: pointer;">FYS Sorumlusu <i class="bi bi-arrow-down-up ms-1 small"></i></th>
                                <th class="kurban-sortable" data-sort-order="asc" style="cursor: pointer;">Diğer Ülkeler <i class="bi bi-arrow-down-up ms-1 small"></i></th>
                                <th class="kurban-sortable" data-sort-order="asc" style="cursor: pointer;">Türkiye <i class="bi bi-arrow-down-up ms-1 small"></i></th>
                                <th>Ödeme Şekilleri</th>
                                <th class="kurban-sortable" data-sort-order="asc" style="cursor: pointer;">Toplam Ödenen <i class="bi bi-arrow-down-up ms-1 small"></i></th>
                                <th class="kurban-sortable" data-sort-order="asc" style="cursor: pointer;">Kalan Bakiye <i class="bi bi-arrow-down-up ms-1 small"></i></th>
                                <th class="kurban-sortable" data-sort-order="asc" style="cursor: pointer;">Tutanak No <i class="bi bi-arrow-down-up ms-1 small"></i></th>
                                <th>Aksiyonlar</th>
                            </tr>
                        </thead>
                        <tbody id="campaignGridBody">
                            <!-- Dynamic Rows -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pagination Controls -->
        @if ((int)(ViewBag.TotalPages ?? 1) > 1)
        {
            <nav class="mt-3" aria-label="Kampanya Kayıtları Sayfalama">
                <ul class="pagination justify-content-center">
                    @if ((int)(ViewBag.CurrentPage ?? 1) > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", "Kurban", new { page = (int)(ViewBag.CurrentPage) - 1, pageSize = ViewBag.PageSize })"><i class="bi bi-chevron-left"></i> Önceki</a>
                        </li>
                    }
                    @for (int p = 1; p <= (int)(ViewBag.TotalPages ?? 1); p++)
                    {
                        <li class="page-item @(p == (int)(ViewBag.CurrentPage ?? 1) ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Kurban", new { page = p, pageSize = ViewBag.PageSize })">@p</a>
                        </li>
                    }
                    @if ((int)(ViewBag.CurrentPage ?? 1) < (int)(ViewBag.TotalPages ?? 1))
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", "Kurban", new { page = (int)(ViewBag.CurrentPage) + 1, pageSize = ViewBag.PageSize })">Sonraki <i class="bi bi-chevron-right"></i></a>
                        </li>
                    }
                </ul>
            </nav>
            <p class="text-center text-muted small">Toplam @ViewBag.TotalCount kayıt — Sayfa @ViewBag.CurrentPage / @ViewBag.TotalPages</p>
        }

        <!-- Multi-Year Performance Comparative Widget -->
        <div class="col-xl-3 col-lg-4">
            <div class="card card-glass shadow-sm border-0 h-100" style="border-radius: 1.25rem;">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="card-title mb-0 fw-bold text-dark"><i class="bi bi-bar-chart-fill text-success me-2"></i>Yıllara Göre Karşılaştırma</h5>
                </div>
                <div class="card-body p-3">
                    <div class="list-group list-group-flush gap-3">
                        <!-- Year 2026 -->
                        <div class="p-3 border rounded shadow-sm hover-up bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary px-3 py-1 fw-bold fs-6">2026</span>
                                <span class="text-success fw-bold" id="compGrowth26">+0%</span>
                            </div>
                            <div class="row g-2 text-muted small">
                                <div class="col-6">Top. Adet: <strong class="text-dark" id="compCount26">0</strong></div>
                                <div class="col-6 text-end">Top. Miktar: <strong class="text-dark" id="compAmount26">0.00 €</strong></div>
                            </div>
                        </div>

                        <!-- Year 2025 -->
                        <div class="p-3 border rounded shadow-sm hover-up bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-secondary px-3 py-1 fw-bold fs-6">2025</span>
                                <span class="text-success fw-bold" id="compGrowth25">+0%</span>
                            </div>
                            <div class="row g-2 text-muted small">
                                <div class="col-6">Top. Adet: <strong class="text-dark" id="compCount25">0</strong></div>
                                <div class="col-6 text-end">Top. Miktar: <strong class="text-dark" id="compAmount25">0.00 €</strong></div>
                            </div>
                        </div>

                        <!-- Year 2024 -->
                        <div class="p-3 border rounded shadow-sm hover-up bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-dark-subtle text-dark px-3 py-1 fw-bold fs-6">2024</span>
                                <span class="text-muted small">Baz Yıl</span>
                            </div>
                            <div class="row g-2 text-muted small">
                                <div class="col-6">Top. Adet: <strong class="text-dark" id="compCount24">0</strong></div>
                                <div class="col-6 text-end">Top. Miktar: <strong class="text-dark" id="compAmount24">0.00 €</strong></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Predictive Forecasting Dashboard Card -->
    <div class="card card-glass shadow-sm border-0 mt-4 mb-5" style="border-radius: 1.25rem;">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold text-dark"><i class="bi bi-magic text-warning me-2"></i>Yapay Zeka Destekli Tahmini Başarı Analitiği (Forecasting)</h5>
            <span class="badge bg-warning-subtle text-warning fw-semibold px-3 py-2">Kampanya Kapanış Hedef Projeksiyonu</span>
        </div>
        <div class="card-body">
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="p-3 border rounded bg-light">
                        <div class="text-muted small mb-1">Geçen Gün (Elapsed)</div>
                        <h4 class="fw-bold mb-0 text-dark">23 Gün</h4>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: 57.5%;"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 border rounded bg-light">
                        <div class="text-muted small mb-1">Kalan Gün (Remaining)</div>
                        <h4 class="fw-bold mb-0 text-dark">17 Gün</h4>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: 42.5%;"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 border rounded bg-light">
                        <div class="text-muted small mb-1">Toplam Hedef (Target Shares)</div>
                        <h4 class="fw-bold mb-0 text-dark" id="forecastTarget">0</h4>
                        <span class="text-muted small">2025'ten +10% Büyüme</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 border rounded bg-light">
                        <div class="text-muted small mb-1">Projeksiyon Toplamı (Projected)</div>
                        <h4 class="fw-bold mb-0" id="forecastProjectedTotal">0</h4>
                        <span class="text-muted small" id="forecastProjectedSub">Lineer Trend Analizi</span>
                    </div>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light text-uppercase font-monospace" style="font-size: 0.8rem;">
                        <tr>
                            <th class="text-start">Cami</th>
                            <th>Mevcut Adet (2026)</th>
                            <th>Geçen Yıl (2025)</th>
                            <th>Cari Hedef (2025 + 10%)</th>
                            <th>Tahmini Dönem Sonu Projeksiyonu</th>
                            <th>Başarı Olasılığı</th>
                            <th style="width: 250px;">Gelişim & Durum Çubuğu</th>
                        </tr>
                    </thead>
                    <tbody id="forecastingGridBody">
                        <!-- Filled dynamically by JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Tahsil Et / Ödeme Al Modali -->
<div class="modal fade" id="tahsilModal" tabindex="-1" aria-labelledby="tahsilModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold" id="tahsilModalLabel">
                    <i class="bi bi-cash-coin me-2"></i> Tahsil Et / Ödeme Al
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-1">Kampanya Kaydı:</p>
                <p class="fw-bold text-dark" id="tahsilCamiName">—</p>
                <hr>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Ödeme Miktarı (€)</label>
                    <input type="number" id="tahsilAmount" class="form-control" step="0.01" min="0.01" placeholder="Örn: 125.00" />
                </div>
                <div class="alert alert-info small" id="tahsilKalanInfo">—</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-success fw-bold" id="btnTahsilSubmit">
                    <i class="bi bi-check-circle me-1"></i> Ödemeyi Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Load all campaign records from MVC Model serialize to JSON
    const rawRecords = @Json.Serialize(Model);
    let currentTahsilId = null;

    function formatCurrency(val) {
        return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(val);
    }

    // Tahsil Et button click handler
    function openTahsilModal(id, camiName, kalanBakiye) {
        currentTahsilId = id;
        document.getElementById('tahsilCamiName').textContent = camiName;
        document.getElementById('tahsilAmount').value = '';
        document.getElementById('tahsilKalanInfo').textContent = 'Mevcut Kalan Bakiye: ' + formatCurrency(kalanBakiye);
        const modal = new bootstrap.Modal(document.getElementById('tahsilModal'));
        modal.show();
    }

    document.getElementById('btnTahsilSubmit').addEventListener('click', async function() {
        const amount = parseFloat(document.getElementById('tahsilAmount').value);
        if (isNaN(amount) || amount <= 0) {
            alert('Lütfen geçerli bir miktar giriniz.');
            return;
        }
        this.disabled = true;
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const response = await fetch('@Url.Action("RecordPayment", "Kurban")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${currentTahsilId}&amount=${amount}&__RequestVerificationToken=${encodeURIComponent(token)}`
            });
            const result = await response.json();
            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('tahsilModal')).hide();
                alert(`Ödeme başarıyla kaydedildi!\nToplam Ödenen: ${formatCurrency(result.toplamOdenen)}\nKalan Bakiye: ${formatCurrency(result.kalanBakiye)}`);
                location.reload();
            } else {
                alert('Hata: ' + result.message);
            }
        } catch(e) {
            alert('Sunucu bağlantı hatası.');
        }
        this.disabled = false;
    });

    // Inject 'Tahsil Et' buttons into campaign grid rows
    // The original grid is populated by JS — we append to existing row builder
    $(document).ready(function() {
        // Patch the row renderer to include the Tahsil Et button
        // The campaignGridBody is filled by the chart script below — we hook in after DOMContentLoaded
        const origRows = rawRecords.map(r => {
            return `<tr data-id="${r.id}">
                <td class="px-3 text-start"><span class="badge bg-secondary-subtle text-secondary">${r.bolge ?? '-'}</span></td>
                <td class="text-start fw-semibold">${r.cami}</td>
                <td>${r.fysSorumlusu ?? '-'}</td>
                <td><span class="badge bg-primary-subtle text-primary fw-bold">${r.digerAdet}</span></td>
                <td><span class="badge bg-success-subtle text-success fw-bold">${r.trAdet}</span></td>
                <td class="small">
                    ${r.havale > 0 ? '<span class="badge bg-info-subtle text-info me-1">H: ' + formatCurrency(r.havale) + '</span>' : ''}
                    ${r.nakit  > 0 ? '<span class="badge bg-warning-subtle text-warning me-1">N: ' + formatCurrency(r.nakit)  + '</span>' : ''}
                    ${r.cek    > 0 ? '<span class="badge bg-secondary-subtle text-secondary me-1">Ç: ' + formatCurrency(r.cek)    + '</span>' : ''}
                    ${r.stripe > 0 ? '<span class="badge bg-purple-subtle text-purple me-1">S: ' + formatCurrency(r.stripe) + '</span>' : ''}
                    ${r.cihaz  > 0 ? '<span class="badge bg-dark-subtle text-dark me-1">C: ' + formatCurrency(r.cihaz)  + '</span>' : ''}
                </td>
                <td class="fw-bold text-success">${formatCurrency(r.toplamOdenen)}</td>
                <td class="fw-bold ${r.kalanBakiye > 0 ? 'text-danger' : 'text-success'}">${formatCurrency(r.kalanBakiye)}</td>
                <td class="small text-muted">${r.tutanakNo ?? '-'}</td>
                <td>
                    <button class="btn btn-sm btn-outline-success rounded-pill"
                        onclick="openTahsilModal(${r.id}, '${r.cami.replace(/'/g, "\\'")}', ${r.kalanBakiye})">
                        <i class="bi bi-cash-coin me-1"></i> Tahsil Et
                    </button>
                </td>
            </tr>`;
        });
        document.getElementById('campaignGridBody').innerHTML = origRows.join('');
    });
</script>
@Html.AntiForgeryToken()
}

        function calculateAggregates() {
            // 2024 Aggregates
            const recs24 = rawRecords.filter(r => r.yil === 2024);
            const count24 = recs24.reduce((sum, r) => sum + r.digerAdet + r.trAdet, 0);
            const amount24 = recs24.reduce((sum, r) => sum + r.digerMiktar + r.trMiktar, 0);

            document.getElementById('compCount24').textContent = count24;
            document.getElementById('compAmount24').textContent = formatCurrency(amount24);

            // 2025 Aggregates
            const recs25 = rawRecords.filter(r => r.yil === 2025);
            const count25 = recs25.reduce((sum, r) => sum + r.digerAdet + r.trAdet, 0);
            const amount25 = recs25.reduce((sum, r) => sum + r.digerMiktar + r.trMiktar, 0);

            document.getElementById('compCount25').textContent = count25;
            document.getElementById('compAmount25').textContent = formatCurrency(amount25);
            if (amount24 > 0) {
                const growth25 = ((amount25 - amount24) / amount24) * 100;
                document.getElementById('compGrowth25').textContent = (growth25 >= 0 ? '+' : '') + growth25.toFixed(1) + '%';
                document.getElementById('compGrowth25').className = growth25 >= 0 ? 'text-success fw-bold' : 'text-danger fw-bold';
            }

            // 2026 Aggregates
            const recs26 = rawRecords.filter(r => r.yil === 2026);
            const count26 = recs26.reduce((sum, r) => sum + r.digerAdet + r.trAdet, 0);
            const amount26 = recs26.reduce((sum, r) => sum + r.digerMiktar + r.trMiktar, 0);

            document.getElementById('compCount26').textContent = count26;
            document.getElementById('compAmount26').textContent = formatCurrency(amount26);
            if (amount25 > 0) {
                const growth26 = ((amount26 - amount25) / amount25) * 100;
                document.getElementById('compGrowth26').textContent = (growth26 >= 0 ? '+' : '') + growth26.toFixed(1) + '%';
                document.getElementById('compGrowth26').className = growth26 >= 0 ? 'text-success fw-bold' : 'text-danger fw-bold';
            }
        }

        function filterYear(selectedYear) {
            const year = parseInt(selectedYear);
            document.getElementById('gridYearBadge').textContent = `Yıl: ${year}`;

            const filtered = rawRecords.filter(r => r.yil === year);

            // Compute statistics
            const digerAdetTotal = filtered.reduce((sum, r) => sum + r.digerAdet, 0);
            const digerMiktarTotal = filtered.reduce((sum, r) => sum + r.digerMiktar, 0);
            const trAdetTotal = filtered.reduce((sum, r) => sum + r.trAdet, 0);
            const trMiktarTotal = filtered.reduce((sum, r) => sum + r.trMiktar, 0);
            const totalCount = digerAdetTotal + trAdetTotal;
            const totalAmount = digerMiktarTotal + trMiktarTotal;
            const totalRemaining = filtered.reduce((sum, r) => sum + r.kalanBakiye, 0);

            document.getElementById('statTotalCount').textContent = totalCount;
            document.getElementById('statDigerCount').textContent = digerAdetTotal;
            document.getElementById('statTrCount').textContent = trAdetTotal;

            document.getElementById('statTotalAmount').textContent = formatCurrency(totalAmount);
            document.getElementById('statDigerAmount').textContent = formatCurrency(digerMiktarTotal);
            document.getElementById('statTrAmount').textContent = formatCurrency(trMiktarTotal);

            document.getElementById('statRemainingAmount').textContent = formatCurrency(totalRemaining);

            // Render table rows
            const tbody = document.getElementById('campaignGridBody');
            tbody.innerHTML = '';

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="text-muted py-4">Bu yıla ait kampanya verisi bulunmamaktadır.</td></tr>`;
                return;
            }

            filtered.forEach(r => {
                const totalCountryCount = r.digerAdet + r.trAdet;
                const totalCountryMiktar = r.digerMiktar + r.trMiktar;

                tbody.innerHTML += `
                    <tr>
                        <td class="px-3 text-start fw-bold text-dark">${r.bolge}</td>
                        <td class="text-start fw-semibold text-primary">${r.cami}</td>
                        <td class="text-muted">${r.fysSorumlusu}</td>
                        <td>
                            <div class="fw-bold">${r.digerAdet} Adet</div>
                            <div class="text-muted small">${formatCurrency(r.digerMiktar)}</div>
                        </td>
                        <td>
                            <div class="fw-bold">${r.trAdet} Adet</div>
                            <div class="text-muted small">${formatCurrency(r.trMiktar)}</div>
                        </td>
                        <td>
                            <div class="text-muted small" style="font-size: 0.75rem;">
                                H: ${formatCurrency(r.havale)} | Ç: ${formatCurrency(r.cek)} | N: ${formatCurrency(r.nakit)}<br/>
                                CC: ${formatCurrency(r.stripe)} | D: ${formatCurrency(r.cihaz)}
                            </div>
                        </td>
                        <td class="fw-bold text-success">${formatCurrency(r.toplamOdenen)}</td>
                        <td class="fw-bold ${r.kalanBakiye > 0 ? 'text-danger' : 'text-muted'}">${formatCurrency(r.kalanBakiye)}</td>
                        <td>
                            <span class="badge bg-light text-dark font-monospace border">${r.tutanakNo || '-'}</span>
                        </td>
                    </tr>
                `;
            });
        }

        function renderForecasting() {
            const elapsedDays = 23;
            const totalDays = 40;
            const remainingDays = totalDays - elapsedDays;

            // Get unique list of mosques in 2026 or 2025
            const mosques = Array.from(new Set(rawRecords.map(r => r.cami)));
            
            const tbody = document.getElementById('forecastingGridBody');
            tbody.innerHTML = '';

            let total2026Count = 0;
            let total2025Count = 0;
            let totalTarget = 0;
            let totalProjected = 0;

            mosques.forEach(camiName => {
                const rec26 = rawRecords.find(r => r.cami === camiName && r.yil === 2026);
                const rec25 = rawRecords.find(r => r.cami === camiName && r.yil === 2025);

                const count26 = rec26 ? (rec26.digerAdet + rec26.trAdet) : 0;
                const count25 = rec25 ? (rec25.digerAdet + rec25.trAdet) : 0;

                // Target = 2025 count + 10% (min 10)
                const target = Math.max(10, Math.round(count25 * 1.1));

                // Projected count = (current count / elapsed) * total
                const projected = Math.round((count26 / elapsedDays) * totalDays);

                total2026Count += count26;
                total2025Count += count25;
                totalTarget += target;
                totalProjected += projected;

                // Probability of Success
                let probText = 'Düşük';
                let probClass = 'bg-danger';
                let textClass = 'text-danger';
                const ratio = target > 0 ? (projected / target) : 1;

                if (ratio >= 1.0) {
                    probText = 'Yüksek';
                    probClass = 'bg-success';
                    textClass = 'text-success';
                } else if (ratio >= 0.8) {
                    probText = 'Orta';
                    probClass = 'bg-warning';
                    textClass = 'text-warning';
                }

                const progressPct = Math.min(100, Math.round((count26 / target) * 100));

                tbody.innerHTML += `
                    <tr>
                        <td class="text-start fw-bold">${camiName}</td>
                        <td class="fw-bold">${count26} Adet</td>
                        <td class="text-muted">${count25} Adet</td>
                        <td class="fw-semibold">${target} Adet</td>
                        <td class="fw-bold ${textClass}">${projected} Adet</td>
                        <td>
                            <span class="badge ${probClass}-subtle ${textClass} px-3 py-1 fw-bold">${probText}</span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar ${probClass}" role="progressbar" style="width: ${progressPct}%;"></div>
                                </div>
                                <span class="small font-monospace fw-bold">${progressPct}%</span>
                            </div>
                        </td>
                    </tr>
                `;
            });

            document.getElementById('forecastTarget').textContent = totalTarget + " Adet";
            document.getElementById('forecastProjectedTotal').textContent = totalProjected + " Adet";
            
            const totalRatio = totalTarget > 0 ? (totalProjected / totalTarget) : 1;
            const forecastEl = document.getElementById('forecastProjectedTotal');
            if (totalRatio >= 1.0) {
                forecastEl.className = 'fw-bold mb-0 text-success';
                document.getElementById('forecastProjectedSub').innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Hedef Yakalanıyor</span>';
            } else if (totalRatio >= 0.8) {
                forecastEl.className = 'fw-bold mb-0 text-warning';
                document.getElementById('forecastProjectedSub').innerHTML = '<span class="text-warning fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Kritik Eşikte</span>';
            } else {
                forecastEl.className = 'fw-bold mb-0 text-danger';
                document.getElementById('forecastProjectedSub').innerHTML = '<span class="text-danger fw-bold"><i class="bi bi-x-circle-fill"></i> Hedef Altında</span>';
            }
        }

        // Initialize dashboard
        document.addEventListener("DOMContentLoaded", () => {
            calculateAggregates();
            filterYear('2026');
            renderForecasting();

            // Wire sorting logic
            document.querySelectorAll('.kurban-sortable').forEach(header => {
                header.addEventListener('click', function() {
                    const tbody = document.getElementById('campaignGridBody');
                    const rows = Array.from(tbody.querySelectorAll('tr'));
                    if (rows.length <= 1 && rows[0]?.querySelector('td')?.colSpan > 1) return;
                    
                    const index = Array.from(header.parentNode.children).indexOf(header);
                    const isAsc = header.dataset.sortOrder === 'asc';
                    const direction = isAsc ? -1 : 1;
                    header.dataset.sortOrder = isAsc ? 'desc' : 'asc';

                    rows.sort((rowA, rowB) => {
                        const cellA = rowA.children[index].textContent.trim();
                        const cellB = rowB.children[index].textContent.trim();

                        const cleanNum = val => {
                            const cleaned = val.replace(/[^\d,\.-]/g, '').replace('.', '').replace(',', '.');
                            const parsed = parseFloat(cleaned);
                            return isNaN(parsed) ? val : parsed;
                        };

                        const valA = cleanNum(cellA);
                        const valB = cleanNum(cellB);

                        if (typeof valA === 'number' && typeof valB === 'number') {
                            return (valA - valB) * direction;
                        }
                        return valA.toString().localeCompare(valB.toString()) * direction;
                    });

                    rows.forEach(row => tbody.appendChild(row));
                });
            });
        });
    </script>
}
