@using DitibStasbourg.Models
@model PaginatedList<DitibStasbourg.Models.Kurum>

@{
    ViewData["Title"] = "Kurumlar";
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<style>
    .accordion-button:not(.collapsed) { background-color: #e7f1ff; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Kurumlar</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Yeni Ekle</a>
</div>

@{
    var filter = ViewData["Filter"] as DitibStasbourg.Models.ViewModels.KurumFilterViewModel ?? new DitibStasbourg.Models.ViewModels.KurumFilterViewModel();
}

<div class="accordion mb-4" id="filterAccordion">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilter">
                <i class="fas fa-filter me-2"></i> Gelişmiş Filtreleme
            </button>
        </h2>
        <div id="collapseFilter" class="accordion-collapse collapse @(!string.IsNullOrEmpty(filter.SearchString) ? "show" : "")">
            <div class="accordion-body">
                <form asp-action="Index" method="get">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Arama (İsim, Adres)</label>
                            <input type="text" name="SearchString" class="form-control" value="@filter.SearchString" placeholder="Kurum adı veya adres..." />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Tip</label>
                            <select name="Tip" class="form-select">
                                <option value="">Tümü</option>
                                <option value="0" selected="@(filter.Tip == KurumTip.Cami)">Cami</option>
                                <option value="1" selected="@(filter.Tip == KurumTip.Dernek)">Dernek</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Şehir</label>
                            <select name="Sehir" class="form-select" asp-items="@(new SelectList(ViewBag.Sehirler, filter.Sehir))">
                                <option value="">Tümü</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Durum</label>
                            <select name="AktifMi" class="form-select">
                                <option value="">Tümü</option>
                                <option value="true" selected="@(filter.AktifMi == true)">Aktif</option>
                                <option value="false" selected="@(filter.AktifMi == false)">Pasif</option>
                            </select>
                        </div>
                        <div class="col-md-12 text-end">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Filtrele</button>
                            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-redo"></i> Temizle</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info">
    <strong>@Model.TotalCount</strong> kurum bulundu.
</div>

<div class="row mb-3 bg-light py-2 rounded">
    <div class="col-md-3 fw-bold">Kurum Adı</div>
    <div class="col-md-2">Tip</div>
    <div class="col-md-2">Şehir</div>
    <div class="col-md-2">Aktif Görevli</div>
    <div class="col-md-2">Durum</div>
    <div class="col-md-1 text-end">İşlemler</div>
</div>

<div class="accordion" id="accordionKurum">
    @foreach (var item in Model) {
        var today = DateTime.Today;
        var activeGorevliler = item.Gorevlendirmeler
            .Where(g => g.Tarih <= today && (g.BitisTarihi == null || g.BitisTarihi >= today))
            .Select(g => g.Gorevli)
            .ToList();
        
        <div class="accordion-item mb-2 shadow-sm border-0">
            <h2 class="accordion-header" id="heading-@item.Id">
                <button class="accordion-button collapsed py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.Id">
                    <div class="container-fluid p-0">
                        <div class="row align-items-center">
                            <div class="col-md-3 fw-bold">
                                @item.Isim
                                <br/><small class="text-muted">@item.Adres</small>
                            </div>
                            <div class="col-md-2">
                                <span class="badge @(item.Tip == KurumTip.Cami ? "bg-primary" : "bg-info")">
                                    @(item.Tip == KurumTip.Cami ? "Cami" : "Dernek")
                                </span>
                            </div>
                            <div class="col-md-2 small text-muted">@item.Sehir</div>
                            <div class="col-md-2">
                                <span class="badge bg-success">@activeGorevliler.Count Aktif</span>
                            </div>
                            <div class="col-md-2">
                                @if (item.AktifMi) {
                                    <span class="text-success"><i class="fas fa-check-circle fa-lg"></i></span>
                                } else {
                                    <span class="text-danger"><i class="fas fa-times-circle fa-lg"></i></span>
                                }
                            </div>
                        </div>
                    </div>
                </button>
            </h2>
            <div id="collapse-@item.Id" class="accordion-collapse collapse">
                <div class="accordion-body bg-white">
                    <div class="d-flex justify-content-end mb-3">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-2">Düzenle</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-2">Detay</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                    </div>
                    
                    <h5 class="border-bottom pb-2">Aktif Görevliler</h5>
                    @if(activeGorevliler.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Ad Soyad</th>
                                        <th>E-posta</th>
                                        <th>Durum</th>
                                        <th>Notlar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var gorevli in activeGorevliler)
                                    {
                                        <tr>
                                            <td>@gorevli.AdSoyad</td>
                                            <td><a href="mailto:@gorevli.Email">@gorevli.Email</a></td>
                                            <td>
                                                @if (gorevli.GorevliDurumBilgisi != null)
                                                {
                                                    <span class="badge" style="background-color: @gorevli.GorevliDurumBilgisi.Renk">
                                                        @gorevli.GorevliDurumBilgisi.Ad
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (gorevli.GorevliNotlari != null && gorevli.GorevliNotlari.Any())
                                                {
                                                    <i class="fas fa-sticky-note text-warning" title="@gorevli.GorevliNotlari.Count not mevcut"></i>
                                                    <small>(@gorevli.GorevliNotlari.Count)</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic">Şu anda aktif görevli yok.</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Pagination -->
<nav class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @prevDisabled">
            <a class="page-link" onclick="changePage(@(Model.PageIndex - 1))">Önceki</a>
        </li>
        @for (var i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" onclick="changePage(@i)">@i</a>
            </li>
        }
        <li class="page-item @nextDisabled">
            <a class="page-link" onclick="changePage(@(Model.PageIndex + 1))">Sonraki</a>
        </li>
    </ul>
</nav>

@section Scripts {
    <script>
        function changePage(pageNum) {
            var form = document.querySelector('#collapseFilter form');
            if (form) {
                var pageInput = document.createElement('input');
                pageInput.type = 'hidden';
                pageInput.name = 'page';
                pageInput.value = pageNum;
                form.appendChild(pageInput);
                form.submit();
            } else {
                window.location.href = '?page=' + pageNum;
            }
        }
    </script>
}
