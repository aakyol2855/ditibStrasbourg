@model DitibStasbourg.Models.Kurum

@{
    ViewData["Title"] = "Detaylar";
}

<h1>Detaylar</h1>

<div>
    <h4>Kurum</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Isim)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Isim)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Adres)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Adres)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tip)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tip)
        </dd>
        <dt class = "col-sm-2">
            Üst Kurum
        </dt>
        <dd class = "col-sm-10">
            @(Model.UstKurum?.Ad ?? "-")
        </dd>
        <dt class = "col-sm-2">
            Aktif personel
        </dt>
        <dd class = "col-sm-10">
            <span class="badge bg-success">@Model.Gorevlendirmeler.Count(g => g.Tarih <= DateTime.Now && (g.BitisTarihi == null || g.BitisTarihi >= DateTime.Now))</span>
        </dd>
        <dt class = "col-sm-2">
            Toplam personel
        </dt>
        <dd class = "col-sm-10">
            <span class="badge bg-secondary">@Model.Gorevlendirmeler.Select(g => g.GorevliId).Distinct().Count()</span>
        </dd>
    </dl>
    
    <div class="mt-4">
        <h5>Aktif Görevliler</h5>
        @if(Model.Gorevlendirmeler != null && Model.Gorevlendirmeler.Any(g => g.Tarih <= DateTime.Now && (g.BitisTarihi == null || g.BitisTarihi >= DateTime.Now)))
        {
            <ul class="list-group">
                @foreach(var gorev in Model.Gorevlendirmeler.Where(g => g.Tarih <= DateTime.Now && (g.BitisTarihi == null || g.BitisTarihi >= DateTime.Now)).OrderByDescending(g => g.Tarih))
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@gorev.Gorevli?.Ad @gorev.Gorevli?.Soyad</strong>
                            <br/><small class="text-muted">Başlangıç: @gorev.Tarih.ToShortDateString()</small>
                        </div>
                        <span class="badge" style="background-color: @(gorev.Gorevli?.GorevliDurumBilgisi?.Renk ?? "gray"); color: white;">@(gorev.Gorevli?.GorevliDurumBilgisi?.Ad ?? "-")</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Aktif görevli bulunmamaktadır.</p>
        }
    </div>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Düzenle</a>
    <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
</div>
