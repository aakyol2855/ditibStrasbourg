@model DitibStasbourg.Models.ViewModels.TrashBinViewModel
@{
    ViewData["Title"] = "Geri Dönüşüm Kutusu (Trash Bin)";
}

<style>
    /* Premium Glassmorphic & Modern Trash Bin Styling */
    .retention-card {
        border-radius: var(--border-radius-lg);
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }
    
    .nav-tabs-custom {
        border-bottom: 2px solid rgba(226, 232, 240, 0.8);
    }
    
    .nav-tabs-custom .nav-link {
        border: none;
        color: var(--platform-muted);
        font-weight: 500;
        padding: 1rem 1.5rem;
        transition: all 0.2s ease;
        position: relative;
    }
    
    .nav-tabs-custom .nav-link.active {
        color: var(--platform-primary);
        background: transparent;
    }
    
    .nav-tabs-custom .nav-link.active::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        height: 2px;
        background-color: var(--platform-primary);
    }

    .trash-table-container {
        border-radius: var(--border-radius-md);
        background: white;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(226, 232, 240, 0.8);
        overflow: hidden;
    }

    .badge-remaining {
        background-color: rgba(245, 158, 11, 0.15);
        color: #b45309;
        font-weight: 600;
        padding: 0.35em 0.65em;
        border-radius: var(--border-radius-sm);
    }

    .badge-expired {
        background-color: rgba(239, 68, 68, 0.15);
        color: #b91c1c;
        font-weight: 600;
        padding: 0.35em 0.65em;
        border-radius: var(--border-radius-sm);
    }
</style>

<div class="container-fluid px-0">
    <!-- Page Header -->
    <div class="row g-4 mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="fw-bold mb-1"><i class="bi bi-trash3 text-danger me-2"></i> Geri Dönüşüm Kutusu</h1>
            <p class="text-muted mb-0">Sistemden yumuşak silinen (soft-deleted) verilerin yönetimi, izlenmesi ve tek tıkla geri yüklenmesi.</p>
        </div>
        <div class="col-md-4 text-md-end">
            <a href="@Url.Action("DataMaintenance", "Admin")" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Bakım Paneli
            </a>
        </div>
    </div>

    <!-- Retention Policy Configuration -->
    <div class="card retention-card border-0 mb-4 p-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-7">
                <h5 class="fw-bold text-dark mb-1"><i class="bi bi-shield-clock text-primary me-2"></i> Otomatik Veri Saklama ve Temizlik Politikası</h5>
                <p class="text-muted small mb-0">
                    Çöp kutusundaki veriler, belirlenen saklama süresi bittiğinde arka planda çalışan zamanlanmış temizlik servisi (Purge Worker) tarafından veritabanından kalıcı olarak silinir.
                </p>
            </div>
            <div class="col-lg-5">
                <form asp-action="UpdateRetentionDays" asp-controller="Admin" method="post" class="d-flex align-items-center justify-content-lg-end gap-2">
                    <label class="text-nowrap text-muted small fw-semibold">Saklama Süresi (Gün):</label>
                    <input type="number" name="days" class="form-control text-center fw-bold" style="width: 80px;" value="@Model.SoftDeleteRetentionDays" min="1" max="365" />
                    <button type="submit" class="btn btn-primary px-3">
                        <i class="bi bi-check-lg me-1"></i> Güncelle
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Feedback alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <!-- Tabs Container -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white p-0">
            <ul class="nav nav-tabs nav-tabs-custom" id="trashTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="dernek-tab" data-bs-toggle="tab" data-bs-target="#dernek-pane" type="button" role="tab" aria-controls="dernek-pane" aria-selected="true">
                        <i class="bi bi-bank me-2"></i> Silinmiş Dernekler (@Model.DeletedAssociations.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="gorevli-tab" data-bs-toggle="tab" data-bs-target="#gorevli-pane" type="button" role="tab" aria-controls="gorevli-pane" aria-selected="false">
                        <i class="bi bi-people me-2"></i> Silinmiş Görevliler (@Model.DeletedPersonnel.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="gorevlendirme-tab" data-bs-toggle="tab" data-bs-target="#gorevlendirme-pane" type="button" role="tab" aria-controls="gorevlendirme-pane" aria-selected="false">
                        <i class="bi bi-calendar-event me-2"></i> Silinmiş Görevlendirmeler (@Model.DeletedAssignments.Count)
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-4 bg-light-subtle">
            <div class="tab-content" id="trashTabsContent">
                
                <!-- Tab Pane: Associations -->
                <div class="tab-pane fade show active" id="dernek-pane" role="tabpanel" aria-labelledby="dernek-tab">
                    @if (!Model.DeletedAssociations.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-trash3 fs-2 d-block mb-3 text-secondary opacity-50"></i>
                            <h6 class="fw-bold">Silinmiş Dernek Bulunmamaktadır</h6>
                            <p class="small mb-0">Çöp kutusu tamamen boş.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive trash-table-container">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th style="width: 5%;">ID</th>
                                        <th style="width: 25%;">Dernek/Kurum Adı</th>
                                        <th style="width: 15%;">Şehir</th>
                                        <th style="width: 20%;">Silinme Tarihi</th>
                                        <th style="width: 15%;">Kalan Süre</th>
                                        <th style="width: 20%;" class="text-end">Aksiyon</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var association in Model.DeletedAssociations)
                                    {
                                        var deletedTimeStr = association.DeletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Belirtilmemiş";
                                        var remainingDays = 30;
                                        if (association.DeletedAt.HasValue)
                                        {
                                            var exp = association.DeletedAt.Value.AddDays(Model.SoftDeleteRetentionDays);
                                            remainingDays = (int)Math.Max(0, (exp - DateTime.UtcNow).TotalDays);
                                        }
                                        <tr>
                                            <td><span class="text-muted fw-semibold">#@association.Id</span></td>
                                            <td><span class="fw-bold text-dark">@association.Isim</span></td>
                                            <td><span class="badge bg-secondary">@association.Sehir</span></td>
                                            <td class="text-muted small">@deletedTimeStr</td>
                                            <td>
                                                @if (remainingDays > 0)
                                                {
                                                    <span class="badge-remaining"><i class="bi bi-hourglass-split me-1"></i> @remainingDays gün</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-expired"><i class="bi bi-exclamation-octagon me-1"></i> Süre Doldu (Silinecek)</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a href="@Url.Action("Restore", "Admin", new { type = "Association", id = association.Id })" class="btn btn-success btn-sm px-3 rounded-pill" onclick="return confirm('@association.Isim derneğini kurtarmak ve geri yüklemek istediğinize emin misiniz?')">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Geri Yükle
                                                </a>
                                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill ms-1 btn-hard-delete"
                                                        data-type="Association"
                                                        data-id="@association.Id"
                                                        data-name="@association.Isim">
                                                    <i class="bi bi-trash3-fill me-1"></i> Kalıcı Sil
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- Tab Pane: Personnel -->
                <div class="tab-pane fade" id="gorevli-pane" role="tabpanel" aria-labelledby="gorevli-tab">
                    @if (!Model.DeletedPersonnel.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-trash3 fs-2 d-block mb-3 text-secondary opacity-50"></i>
                            <h6 class="fw-bold">Silinmiş Görevli Bulunmamaktadır</h6>
                            <p class="small mb-0">Çöp kutusu tamamen boş.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive trash-table-container">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th style="width: 5%;">ID</th>
                                        <th style="width: 25%;">Görevli Ad Soyad</th>
                                        <th style="width: 20%;">E-posta</th>
                                        <th style="width: 15%;">Silinme Tarihi</th>
                                        <th style="width: 15%;">Kalan Süre</th>
                                        <th style="width: 20%;" class="text-end">Aksiyon</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var gorevli in Model.DeletedPersonnel)
                                    {
                                        var deletedTimeStr = gorevli.DeletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Belirtilmemiş";
                                        var remainingDays = 30;
                                        if (gorevli.DeletedAt.HasValue)
                                        {
                                            var exp = gorevli.DeletedAt.Value.AddDays(Model.SoftDeleteRetentionDays);
                                            remainingDays = (int)Math.Max(0, (exp - DateTime.UtcNow).TotalDays);
                                        }
                                        <tr>
                                            <td><span class="text-muted fw-semibold">#@gorevli.Id</span></td>
                                            <td><span class="fw-bold text-dark">@gorevli.Ad @gorevli.Soyad</span></td>
                                            <td class="small">@gorevli.Email</td>
                                            <td class="text-muted small">@deletedTimeStr</td>
                                            <td>
                                                @if (remainingDays > 0)
                                                {
                                                    <span class="badge-remaining"><i class="bi bi-hourglass-split me-1"></i> @remainingDays gün</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-expired"><i class="bi bi-exclamation-octagon me-1"></i> Süre Doldu (Silinecek)</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a href="@Url.Action("Restore", "Admin", new { type = "Personnel", id = gorevli.Id })" class="btn btn-success btn-sm px-3 rounded-pill" onclick="return confirm('@gorevli.Ad @gorevli.Soyad görevlisini kurtarmak ve geri yüklemek istediğinize emin misiniz?')">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Geri Yükle
                                                </a>
                                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill ms-1 btn-hard-delete"
                                                        data-type="Personnel"
                                                        data-id="@gorevli.Id"
                                                        data-name="@gorevli.Ad @gorevli.Soyad">
                                                    <i class="bi bi-trash3-fill me-1"></i> Kalıcı Sil
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- Tab Pane: Assignments -->
                <div class="tab-pane fade" id="gorevlendirme-pane" role="tabpanel" aria-labelledby="gorevlendirme-tab">
                    @if (!Model.DeletedAssignments.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-trash3 fs-2 d-block mb-3 text-secondary opacity-50"></i>
                            <h6 class="fw-bold">Silinmiş Görevlendirme Bulunmamaktadır</h6>
                            <p class="small mb-0">Çöp kutusu tamamen boş.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive trash-table-container">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th style="width: 5%;">ID</th>
                                        <th style="width: 25%;">Görevli</th>
                                        <th style="width: 20%;">Dernek/Kurum</th>
                                        <th style="width: 15%;">Silinme Tarihi</th>
                                        <th style="width: 15%;">Kalan Süre</th>
                                        <th style="width: 20%;" class="text-end">Aksiyon</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var assignment in Model.DeletedAssignments)
                                    {
                                        var deletedTimeStr = assignment.DeletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Belirtilmemiş";
                                        var remainingDays = 30;
                                        if (assignment.DeletedAt.HasValue)
                                        {
                                            var exp = assignment.DeletedAt.Value.AddDays(Model.SoftDeleteRetentionDays);
                                            remainingDays = (int)Math.Max(0, (exp - DateTime.UtcNow).TotalDays);
                                        }
                                        <tr>
                                            <td><span class="text-muted fw-semibold">#@assignment.Id</span></td>
                                            <td>
                                                @if (assignment.Gorevli != null)
                                                {
                                                    <span class="fw-bold text-dark">@assignment.Gorevli.Ad @assignment.Gorevli.Soyad</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted italic">Görevli Bilgisi Yok</span>
                                                }
                                            </td>
                                            <td>
                                                @if (assignment.Kurum != null)
                                                {
                                                    <span class="fw-bold text-dark">@assignment.Kurum.Isim</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted italic">Dernek Bilgisi Yok</span>
                                                }
                                            </td>
                                            <td class="text-muted small">@deletedTimeStr</td>
                                            <td>
                                                @if (remainingDays > 0)
                                                {
                                                    <span class="badge-remaining"><i class="bi bi-hourglass-split me-1"></i> @remainingDays gün</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-expired"><i class="bi bi-exclamation-octagon me-1"></i> Süre Doldu (Silinecek)</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a href="@Url.Action("Restore", "Admin", new { type = "Assignment", id = assignment.Id })" class="btn btn-success btn-sm px-3 rounded-pill" onclick="return confirm('Görevlendirmeyi kurtarmak ve geri yüklemek istediğinize emin misiniz?')">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Geri Yükle
                                                </a>
                                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill ms-1 btn-hard-delete"
                                                        data-type="Assignment"
                                                        data-id="@assignment.Id"
                                                        data-name="Görevlendirme #@assignment.Id">
                                                    <i class="bi bi-trash3-fill me-1"></i> Kalıcı Sil
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════
     ZORUNLU KALICI SİLME ONAY MODALI
     DİTİB Strasbourg — Silme Güvenlik Duvarı v2.0
     ═══════════════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="hardDeleteModal" tabindex="-1" aria-labelledby="hardDeleteModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="hardDeleteModalLabel">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i> KESİN SİLME — GERİ ALINAMAZ!
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body py-4">
                <div class="alert alert-danger border-2 fw-semibold mb-3">
                    <i class="bi bi-shield-exclamation me-2"></i>
                    DİKKAT: Bu işlem geri alınamaz! Devam ederseniz veri geri dönüşümsüz olarak silinecektir.
                </div>
                <p class="text-muted small mb-1">Kalıcı olarak silmek istediğiniz kayıt:</p>
                <p class="fw-bold text-dark fs-6" id="hardDeleteTargetName">—</p>
                <p class="text-muted small">Bu işlemi onaylamak için lütfen aşağıdaki kutuya <strong>"SİL"</strong> yazınız.</p>
                <input type="text" id="hardDeleteConfirmInput" class="form-control" placeholder='Onaylamak için "SİL" yazın' autocomplete="off" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal Et</button>
                <form id="hardDeleteForm" method="post" action="@Url.Action("HardDeleteFromTrashBin", "Admin")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="type" id="hdType" />
                    <input type="hidden" name="id" id="hdId" />
                    <button type="submit" id="hardDeleteSubmitBtn" class="btn btn-danger fw-bold" disabled>
                        <i class="bi bi-trash3-fill me-1"></i> Evet, Kalıcı Olarak Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Hard Delete Modal Logic — strict confirmation required
    document.querySelectorAll('.btn-hard-delete').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const type = this.getAttribute('data-type');
            const id   = this.getAttribute('data-id');
            const name = this.getAttribute('data-name');

            document.getElementById('hdType').value = type;
            document.getElementById('hdId').value   = id;
            document.getElementById('hardDeleteTargetName').textContent = name;
            document.getElementById('hardDeleteConfirmInput').value = '';
            document.getElementById('hardDeleteSubmitBtn').disabled = true;

            const modal = new bootstrap.Modal(document.getElementById('hardDeleteModal'));
            modal.show();
        });
    });

    document.getElementById('hardDeleteConfirmInput').addEventListener('input', function() {
        const submitBtn = document.getElementById('hardDeleteSubmitBtn');
        submitBtn.disabled = this.value.trim().toUpperCase() !== 'SİL';
    });
</script>
}
