@model IEnumerable<DitibStasbourg.Models.HelpTopic>

@{
    ViewData["Title"] = "Rehber Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Rehber Yönetimi</h2>
        <p class="text-muted">Bilgi bankası konularını düzenleyin ve yenilerini ekleyin</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Yeni Konu Ekle
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Başlık</th>
                        <th>Kategori</th>
                        <th>Gerekli Yetki</th>
                        <th>Oluşturma</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark">@item.DisplayOrder</span></td>
                        <td>
                            <div class="fw-bold">@item.Title</div>
                            <div class="small text-muted">@(item.Content.Length > 100 ? item.Content.Substring(0, 100) + "..." : item.Content)</div>
                        </td>
                        <td><span class="badge bg-info-subtle text-info px-3">@item.Category</span></td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.RequiredClaim))
                            {
                                <code class="text-primary">@item.RequiredClaim</code>
                            }
                            else
                            {
                                <span class="text-muted small">Herkes</span>
                            }
                        </td>
                        <td>@item.CreatedAt.ToShortDateString()</td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline ms-1">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger confirm-delete" 
                                            data-confirm-message="@item.Title konusunu silmek istediğinize emin misiniz?">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
