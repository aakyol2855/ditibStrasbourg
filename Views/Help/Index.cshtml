<!-- Platform Architect: Abdulvahab Akyol -->
@model IEnumerable<DitibStasbourg.Models.HelpTopic>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Bilgi Bankası";
}

<div class="row">
    <!-- Categories Sidebar -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
            <div class="card-header bg-white border-bottom-0 py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-list-task me-2"></i>Kategoriler</h5>
            </div>
            <div class="list-group list-group-flush px-2 pb-3">
                <a asp-action="Index" asp-route-category="" 
                   class="list-group-item list-group-item-action border-0 rounded mb-1 @(string.IsNullOrEmpty(ViewBag.SelectedCategory as string) ? "active" : "")">
                    <i class="bi bi-grid-fill me-2"></i>Tüm Konular
                </a>
                @foreach (var cat in ViewBag.Categories as IEnumerable<string>)
                {
                    <a asp-action="Index" asp-route-category="@cat" 
                       class="list-group-item list-group-item-action border-0 rounded mb-1 @(ViewBag.SelectedCategory as string == cat ? "active" : "")">
                        <i class="bi bi-folder2-open me-2"></i>@cat
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Help Content -->
    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">Bilgi Bankası</h2>
                <p class="text-muted">Platform kullanımı hakkında detaylı rehberler</p>
            </div>
            @if (User.HasClaim("Permission", "Help-Admin"))
            {
                <a asp-action="Admin" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-gear me-2"></i>Rehber Yönetimi
                </a>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
                <p class="mt-3 text-muted">Bu kategoride henüz konu bulunmuyor.</p>
            </div>
        }
        else
        {
            @foreach (var topic in Model)
            {
                <div class="card border-0 shadow-sm mb-4" id="topic-@topic.Id">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h3 class="fw-bold mb-0">@topic.Title</h3>
                            <span class="badge bg-light text-primary px-3 py-2">@topic.Category</span>
                        </div>
                        <hr class="opacity-10" />
                        <div class="help-content">
                            @Html.Raw(topic.Content)
                        </div>
                        <div class="mt-4 text-muted small">
                            <i class="bi bi-clock me-1"></i> Son güncelleme: @(topic.UpdatedAt?.ToShortDateString() ?? topic.CreatedAt.ToShortDateString())
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <style>
        .help-content h3 { font-size: 1.5rem; margin-top: 1.5rem; margin-bottom: 1rem; color: var(--platform-primary); }
        .help-content ul { padding-left: 1.2rem; }
        .help-content li { margin-bottom: 0.5rem; }
        .help-content strong { color: var(--platform-text-main); }
    </style>
}
