@model DitibStasbourg.Models.HelpTopic

@{
    ViewData["Title"] = "Konuyu Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold">Yardım Konusunu Düzenle</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label fw-bold">Başlık</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DisplayOrder" class="form-label fw-bold">Sıralama</label>
                            <input asp-for="DisplayOrder" class="form-control" type="number" />
                            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-bold">Kategori</label>
                            <select asp-for="Category" class="form-select">
                                <option value="Genel">Genel</option>
                                <option value="Personel">Personel Yönetimi</option>
                                <option value="Görevlendirme">Görevlendirme</option>
                                <option value="Sistem Yönetimi">Sistem Yönetimi</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RequiredClaim" class="form-label fw-bold">Gerekli Yetki (Claim)</label>
                            <input asp-for="RequiredClaim" class="form-control" />
                            <span asp-validation-for="RequiredClaim" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-bold">İçerik (HTML desteklenir)</label>
                        <textarea asp-for="Content" class="form-control" rows="10"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Admin" class="btn btn-light px-4">İptal</a>
                        <button type="submit" class="btn btn-primary px-5">Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
