@model DitibStasbourg.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Executive Information Dashboard";
}

<!-- Executive Dashboard CSS Variables & Animations -->
<style>
    :root {
        --glass-bg: rgba(255, 255, 255, 0.75);
        --glass-border: rgba(226, 232, 240, 0.8);
        --card-shadow: 0 4px 20px -2px rgba(50, 50, 93, 0.05), 0 2px 8px -1px rgba(0, 0, 0, 0.02);
        --hover-shadow: 0 12px 30px -4px rgba(50, 50, 93, 0.12), 0 4px 12px -2px rgba(0, 0, 0, 0.05);
    }

    .executive-card {
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        position: relative;
    }

    .executive-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--hover-shadow);
        border-color: rgba(59, 130, 246, 0.3);
    }

    .metric-icon-wrapper {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        transition: transform 0.3s ease;
    }

    .executive-card:hover .metric-icon-wrapper {
        transform: scale(1.1) rotate(3deg);
    }

    .quick-action-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        border-radius: 12px;
        border: 1px solid var(--glass-border);
        background: #ffffff;
        transition: all 0.2s ease;
        text-decoration: none;
        color: #334155;
    }

    .quick-action-btn:hover {
        background: #f8fafc;
        border-color: #3b82f6;
        color: #2563eb;
        transform: translateY(-2px);
    }

    .quick-action-btn i {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }
</style>

<!-- Dashboard Top Header -->
<div class="row align-items-center mb-4 pb-3 border-bottom">
    <div class="col-md-8">
        <h1 class="h3 fw-bold text-slate-800 mb-1"><i class="fa-solid fa-chart-line text-primary me-2"></i>Executive Information Dashboard</h1>
        <p class="text-muted mb-0">DİTİB Strasbourg (Alsace Bölgesi) Gerçek Zamanlı Yönetim ve Karar Destek Paneli</p>
    </div>
    <div class="col-md-4 text-md-end text-muted small mt-2 mt-md-0">
        <div class="badge bg-white border text-dark p-2 rounded-3 shadow-xs">
            <i class="fa-regular fa-clock me-1 text-primary"></i> @DateTime.Now.ToString("dd MMMM yyyy, dddd HH:mm")
        </div>
    </div>
</div>

@if (Model.ImmigrationWarnings?.Any() == true)
{
    <div class="alert alert-warning border-0 shadow-sm p-4 mb-4" style="border-radius: 16px; background: rgba(254, 243, 199, 0.95); backdrop-filter: blur(10px); color: #78350f;">
        <div class="d-flex align-items-start gap-3">
            <div class="bg-warning bg-opacity-20 text-warning-emphasis p-2 rounded-3">
                <i class="fa-solid fa-triangle-exclamation fs-4 text-warning"></i>
            </div>
            <div class="flex-grow-1">
                <h5 class="fw-bold mb-1" style="color: #78350f;">Kritik Vize / Pasaport / Oturum İzni Süre Uyarıları</h5>
                <p class="small mb-3" style="color: #92400e;">Aşağıdaki görevlilerin resmi belgelerinin geçerlilik süreleri 3 aydan az kalmıştır. Lütfen gerekli yenileme prosedürlerini başlatın.</p>
                
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 align-middle text-amber-900" style="font-size: 0.85rem; --bs-table-bg: transparent; --bs-table-hover-bg: rgba(217, 119, 6, 0.05);">
                        <thead>
                            <tr class="text-amber-800 border-amber-200">
                                <th class="fw-bold">Görevli Adı Soyadı</th>
                                <th class="fw-bold">Belge Türü</th>
                                <th class="fw-bold">Geçerlilik Bitiş Tarihi</th>
                                <th class="fw-bold">Kalan Gün</th>
                                <th class="fw-bold">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var warning in Model.ImmigrationWarnings)
                            {
                                <tr style="border-bottom: 1px solid rgba(217, 119, 6, 0.15);">
                                    <td class="fw-bold">@warning.AdSoyad</td>
                                    <td>
                                        <span class="badge bg-warning bg-opacity-25 text-warning-emphasis fw-bold">@warning.WarningType</span>
                                    </td>
                                    <td>@warning.ExpirationDate.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        @if (warning.RemainingDays <= 0)
                                        {
                                            <span class="text-danger fw-bold"><i class="fa-solid fa-circle-exclamation me-1"></i> Süresi Doldu!</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold">@warning.RemainingDays Gün</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Gorevli" asp-action="Edit" asp-route-id="@warning.GorevliId" class="btn btn-xs btn-amber px-2 py-1 fw-bold text-decoration-none" style="font-size: 0.75rem; background: #d97706; color: #fff; border-radius: 4px; border: none;">
                                            <i class="fa-solid fa-pen me-1"></i> Düzenle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

<!-- Dynamic Top Metric Grid -->
<div class="row g-4 mb-4">
    <!-- Associations Counter Card -->
    <div class="col-xl col-md-6">
        <a asp-controller="DernekIslemleri" asp-action="Index" class="text-decoration-none">
            <div class="executive-card p-4 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small uppercase tracking-wider d-block mb-1">Kurumlar (Dernek & Cami)</span>
                    <h3 class="fw-bold mb-0 text-slate-900">@Model.TotalKurum</h3>
                    <span class="text-primary small fw-semibold"><i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Listeyi İncele</span>
                </div>
                <div class="metric-icon-wrapper bg-primary bg-opacity-10 text-primary">
                    <i class="fa-solid fa-hotel fs-4"></i>
                </div>
            </div>
        </a>
    </div>

    <!-- Active Staff Counter Card -->
    <div class="col-xl col-md-6">
        <a asp-controller="Gorevli" asp-action="Index" class="text-decoration-none">
            <div class="executive-card p-4 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small uppercase tracking-wider d-block mb-1">Toplam Görevli Havuzu</span>
                    <h3 class="fw-bold mb-0 text-slate-900">@Model.TotalGorevli</h3>
                    <span class="text-success small fw-semibold">
                        <i class="fa-solid fa-circle me-1" style="font-size: 8px;"></i> @Model.ActiveGorevli Hack Aktif Görevde
                    </span>
                </div>
                <div class="metric-icon-wrapper bg-success bg-opacity-10 text-success">
                    <i class="fa-solid fa-users fs-4"></i>
                </div>
            </div>
        </a>
    </div>

    <!-- Assignments Counter Card -->
    <div class="col-xl col-md-6">
        <a asp-controller="Gorevlendirme" asp-action="Index" class="text-decoration-none">
            <div class="executive-card p-4 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small uppercase tracking-wider d-block mb-1">Görevlendirme Atamaları</span>
                    <h3 class="fw-bold mb-0 text-slate-900">@Model.TotalGorevlendirme</h3>
                    <span class="text-warning small fw-semibold">
                        <i class="fa-solid fa-calendar-check me-1"></i> @Model.UpcomingAssignments Yaklaşan Planlanmış
                    </span>
                </div>
                <div class="metric-icon-wrapper bg-warning bg-opacity-10 text-warning">
                    <i class="fa-solid fa-calendar-days fs-4"></i>
                </div>
            </div>
        </a>
    </div>

    <!-- Assignments This Year Counter Card -->
    <div class="col-xl col-md-6">
        <a asp-controller="Gorevlendirme" asp-action="Index" class="text-decoration-none">
            <div class="executive-card p-4 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small uppercase tracking-wider d-block mb-1">Bu Yıl Yapılan Görevler</span>
                    <h3 class="fw-bold mb-0 text-slate-900">@Model.GorevlendirmeThisYear</h3>
                    <span class="text-info small fw-semibold">
                        <i class="fa-solid fa-chart-line me-1"></i> @Model.GorevlendirmeThisMonth Bu Ay Eklenen
                    </span>
                </div>
                <div class="metric-icon-wrapper bg-info bg-opacity-10 text-info">
                    <i class="fa-solid fa-chart-bar fs-4"></i>
                </div>
            </div>
        </a>
    </div>

    <div class="col-xl col-md-6">
        <a href="#consolidatedVacancySection" class="text-decoration-none" onclick="toggleVacancyView('unstaffed')">
            <div class="executive-card p-4 h-100 d-flex align-items-center justify-content-between border-danger-subtle bg-danger-subtle bg-opacity-10">
                <div>
                    <span class="text-muted fw-semibold small uppercase tracking-wider d-block mb-1">Kadro Açığı Olan Camiler</span>
                    <h3 class="fw-bold mb-0 text-danger">@Model.GorevlisiOlmayanKurumlar.Count</h3>
                    <span class="text-danger small fw-semibold"><i class="fa-solid fa-triangle-exclamation me-1"></i>Açıkları İncele</span>
                    @if (Model.ExpiringAssignmentsCount > 0)
                    {
                        <div class="mt-2 small text-muted">
                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                            <span class="text-warning fw-bold">@Model.ExpiringAssignmentsCount Kurumun</span> Görev Süresi Azalıyor
                        </div>
                    }
                </div>
                <div class="metric-icon-wrapper bg-danger bg-opacity-10 text-danger">
                    <i class="fa-solid fa-house-circle-exclamation fs-4"></i>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Main Panels Row -->
<div class="row g-4">
    <!-- Left Column: OSRM Route Map & Financial Campaign Insights -->
    <div class="col-lg-8">
        <!-- OSRM Interactive Route Map -->
        <div class="executive-card p-0 mb-4 overflow-hidden">
            <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-slate-800"><i class="fa-solid fa-map-location-dot text-primary me-2"></i>Bölgesel Erişim ve OSRM Rota Ağı</h5>
                <span class="badge bg-light text-muted">Canlı Harita Servisi</span>
            </div>
            <div class="p-0 border-top">
                @await Component.InvokeAsync("Map")
            </div>
        </div>

        <!-- Vacancy & Placement Warning Grid -->
        <div class="executive-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-0 fw-bold text-slate-800"><i class="fa-solid fa-triangle-exclamation text-warning me-2"></i>Kurumsal Kadro Boşluk Analizi</h5>
                    <p class="text-muted mb-0 small">Kadro açığı bulunan veya görevlendirme süresi dolmak üzere olan kurumların detaylı listesi.</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/DernekIslemleri/ExportExcel?missingStaffOnly=true" class="btn btn-outline-success btn-sm">
                        <i class="fa-solid fa-file-excel me-1"></i>Kadro Açığı Raporu (Excel)
                    </a>
                </div>
            </div>

            <!-- Toggle Buttons -->
            <div class="d-flex border-bottom pb-2 mb-3">
                <button type="button" class="btn btn-sm btn-outline-primary active me-2 px-3 py-2 rounded-pill shadow-sm" id="btnShowUnstaffed" onclick="toggleVacancyView('unstaffed')">
                    <i class="fa-solid fa-hotel me-1"></i>Görevlisi Olmayan Kurumlar (@Model.GorevlisiOlmayanKurumlar.Count)
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning px-3 py-2 rounded-pill shadow-sm" id="btnShowExpiring" onclick="toggleVacancyView('expiring')">
                    <i class="fa-solid fa-clock me-1"></i>Görev Süresi Dolanlar (@Model.SuresiBitenGorevlendirmeler.Count)
                </button>
            </div>

            <!-- Content Area (Consolidated Dynamic Grid) -->
            <div id="consolidatedVacancySection">
                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0" id="vacancyTable">
                        <thead class="table-light">
                            <tr id="vacancyTableHeader">
                                <!-- Dynamic Headers -->
                            </tr>
                        </thead>
                        <tbody id="vacancyTableBody">
                            <!-- Dynamic Content -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Financial Campaign Insights Panel -->
        <div class="executive-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="mb-0 fw-bold text-slate-800"><i class="fa-solid fa-vault text-primary me-2"></i>Yıllık Finansal Kampanya Analizi</h5>
                <span class="badge bg-primary bg-opacity-10 text-primary">Fitre, Zekat & Fidye</span>
            </div>
            
            <div class="row align-items-center">
                <div class="col-md-7">
                    <div style="position: relative; height: 260px; width: 100%;">
                        <canvas id="financialInsightsChart"></canvas>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="table-responsive" style="max-height: 260px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle small mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Yıl</th>
                                    <th>Kampanya</th>
                                    <th class="text-end">Toplanan Tutar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.CampaignSummaries?.Count > 0)
                                {
                                    @foreach (var campaign in Model.CampaignSummaries)
                                    {
                                        <tr>
                                            <td class="fw-bold">@campaign.Year</td>
                                            <td>
                                                @switch (campaign.CampaignType)
                                                {
                                                    case "Fitre":
                                                        <span class="badge bg-teal bg-opacity-10 text-success">Fitre</span>
                                                        break;
                                                    case "Zekat":
                                                        <span class="badge bg-indigo bg-opacity-10 text-primary">Zekat</span>
                                                        break;
                                                    case "Fidye":
                                                        <span class="badge bg-purple bg-opacity-10 text-purple">Fidye</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary bg-opacity-10 text-muted">@campaign.CampaignType</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="text-end fw-semibold text-slate-900">@campaign.TotalAmount.ToString("C2", new System.Globalization.CultureInfo("fr-FR"))</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">Kayıtlı finansal kampanya dönemi bulunmamaktadır.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Regional Density, Sacrificial Ledger & Quick Commands -->
    <div class="col-lg-4">
        <!-- Sacrificial Ledger Accountability Widget -->
        <div class="executive-card p-4 mb-4">
            <h5 class="mb-3 fw-bold text-slate-800"><i class="fa-solid fa-calculator text-primary me-2"></i>Kurban Hisse ve Ödemeler</h5>
            
            <!-- Progress Bar -->
            @{
                var fillRate = Model.TotalKurbanShares > 0 ? (double)Model.SoldKurbanShares / Model.TotalKurbanShares * 100 : 0;
            }
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1 small text-muted">
                    <span>Hisse Satış Oranı</span>
                    <span class="fw-bold text-slate-900">@fillRate.ToString("F1")%</span>
                </div>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar bg-warning progress-bar-striped progress-bar-animated" style="width: @fillRate%"></div>
                </div>
                <div class="d-flex justify-content-between mt-1 small">
                    <span class="text-muted">@Model.SoldKurbanShares Satılan</span>
                    <span class="text-muted">@Model.RemainingKurbanShares Boş Hisse</span>
                </div>
            </div>

            <!-- Live Ledger -->
            <div class="row g-2 border-top pt-3 text-center">
                <div class="col border-end">
                    <span class="d-block text-muted small mb-1">Toplam Tahsilat</span>
                    <h5 class="fw-bold text-success mb-0">@Model.TotalKurbanCollected.ToString("C2", new System.Globalization.CultureInfo("fr-FR"))</h5>
                </div>
                <div class="col">
                    <span class="d-block text-muted small mb-1">Bekleyen Bakiye</span>
                    <h5 class="fw-bold text-danger mb-0">@Model.TotalKurbanOverdue.ToString("C2", new System.Globalization.CultureInfo("fr-FR"))</h5>
                </div>
            </div>
            
            <div class="mt-3 text-center">
                <a asp-controller="Kurban" asp-action="Index" class="btn btn-outline-warning btn-sm w-100 text-dark">
                    <i class="fa-solid fa-cow me-1"></i> Kurban Detay & Hisse Yönetimi
                </a>
            </div>
        </div>

        <!-- Quick Administrative Actions Panel -->
        <div class="executive-card p-4">
            <h5 class="mb-3 fw-bold text-slate-800"><i class="fa-solid fa-bolt text-primary me-2"></i>Hızlı Yönetim Kısayolları</h5>
            <div class="row g-3">
                <div class="col-6">
                    <a asp-controller="DernekIslemleri" asp-action="Create" class="quick-action-btn">
                        <i class="fa-solid fa-plus text-primary"></i>
                        <span class="small fw-semibold">Yeni Dernek</span>
                    </a>
                </div>
                <div class="col-6">
                    <a asp-controller="Gorevli" asp-action="Create" class="quick-action-btn">
                        <i class="fa-solid fa-user-plus text-success"></i>
                        <span class="small fw-semibold">Yeni Görevli</span>
                    </a>
                </div>
                <div class="col-6">
                    <a asp-controller="Gorevlendirme" asp-action="Create" class="quick-action-btn">
                        <i class="fa-solid fa-calendar-plus text-warning"></i>
                        <span class="small fw-semibold">Yeni Görev</span>
                    </a>
                </div>
                <div class="col-6">
                    <a asp-controller="Kurban" asp-action="Index" class="quick-action-btn">
                        <i class="fa-solid fa-cow text-info"></i>
                        <span class="small fw-semibold">Kurban Ekle</span>
                    </a>
                </div>
                
                @if (User.IsInRole("SuperAdmin"))
                {
                    <div class="col-6">
                        <a href="/Admin/TrashBin" class="quick-action-btn bg-light-danger text-danger">
                            <i class="fa-solid fa-trash-can text-danger"></i>
                            <span class="small fw-semibold text-danger">Çöp Kutusu</span>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/Admin/DataMaintenance" class="quick-action-btn">
                            <i class="fa-solid fa-file-excel text-success"></i>
                            <span class="small fw-semibold">Excel Yükleme</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Registration & Initialization -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var ctx = document.getElementById('financialInsightsChart');
        if (ctx) {
            // Group and format model data dynamically for Chart.js
            var rawData = @Html.Raw(Json.Serialize(Model.CampaignSummaries));
            
            // Extract distinct years and campaign types
            var years = [...new Set(rawData.map(item => item.year))].sort();
            var campaignTypes = [...new Set(rawData.map(item => item.campaignType))];

            // Define color palette matching dashboard aesthetics
            var colorPalette = {
                'Fitre': 'rgba(20, 184, 166, 0.8)',   // Teal
                'Zekat': 'rgba(79, 70, 229, 0.8)',   // Indigo
                'Fidye': 'rgba(147, 51, 234, 0.8)'    // Purple
            };

            // Build datasets dynamically
            var datasets = campaignTypes.map(type => {
                var data = years.map(year => {
                    var match = rawData.find(item => item.year === year && item.campaignType === type);
                    return match ? match.totalAmount : 0;
                });

                return {
                    label: type,
                    data: data,
                    backgroundColor: colorPalette[type] || 'rgba(100, 116, 139, 0.8)',
                    borderRadius: 6,
                    borderWidth: 0
                };
            });

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: years,
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: {
                                boxWidth: 12,
                                font: {
                                    size: 11,
                                    family: 'Inter, system-ui, sans-serif'
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    var label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (context.parsed.y !== null) {
                                        label += new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(context.parsed.y);
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            stacked: false,
                            grid: { display: false }
                        },
                        y: {
                            stacked: false,
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumSignificantDigits: 3 }).format(value);
                                }
                            }
                        }
                    }
                }
            });
        }
    });

    const unstaffedKurumsData = @Html.Raw(Json.Serialize(Model.GorevlisiOlmayanKurumlar.Select(k => new {
        id = k.Id,
        isim = k.Isim,
        adres = k.Adres,
        bolge = k.Bolge,
        iletisimNumarasi = k.IletisimNumarasi,
        maili = k.Maili
    })));

    const expiringGorevlendirmesData = @Html.Raw(Json.Serialize(Model.SuresiBitenGorevlendirmeler.Select(g => new {
        gorevliId = g.GorevliId,
        kurumId = g.KurumId,
        gorevliAdSoyad = g.Gorevli != null ? g.Gorevli.AdSoyad : "Bilinmiyor",
        gorevliEmail = g.Gorevli != null ? g.Gorevli.Email ?? "" : "",
        kurumIsim = g.Kurum != null ? g.Kurum.Isim ?? "Bilinmiyor" : "Bilinmiyor",
        kurumBolge = g.Kurum != null ? g.Kurum.Bolge ?? "" : "",
        tarihFormatted = g.Tarih.ToString("dd.MM.yyyy"),
        bitisTarihiFormatted = g.BitisTarihi != null ? g.BitisTarihi.Value.ToString("dd.MM.yyyy") : "",
        remainingDays = g.BitisTarihi.HasValue ? (g.BitisTarihi.Value - DateTime.Today).Days : 0
    })));

    function renderVacancyGrid(view) {
        const headerRow = document.getElementById('vacancyTableHeader');
        const tbody = document.getElementById('vacancyTableBody');
        if (!headerRow || !tbody) return;

        headerRow.innerHTML = '';
        tbody.innerHTML = '';

        if (view === 'unstaffed') {
            headerRow.innerHTML = `
                <th>Kurum Adı</th>
                <th>Bölge</th>
                <th>Telefon / E-posta</th>
                <th>Durum</th>
                <th class="text-end">İşlem</th>
            `;

            if (unstaffedKurumsData && unstaffedKurumsData.length > 0) {
                unstaffedKurumsData.forEach(kurum => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>
                            <div class="fw-bold text-slate-900">${kurum.isim || ''}</div>
                            <span class="text-muted small">${kurum.adres || ''}</span>
                        </td>
                        <td><span class="badge bg-secondary-subtle text-secondary px-2 py-1">Bolge ${kurum.bolge || ''}</span></td>
                        <td>
                            <div>${kurum.iletisimNumarasi || ''}</div>
                            <div class="text-muted small">${kurum.maili || ''}</div>
                        </td>
                        <td><span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1"><i class="fa-solid fa-user-slash me-1"></i>Görevli Ataması Yok</span></td>
                        <td class="text-end">
                            <a href="/Gorevlendirme?targetKurumId=${kurum.id}" class="btn btn-xs btn-outline-primary py-1 px-2" style="font-size: 0.75rem;"><i class="fa-solid fa-user-plus me-1"></i>Atama Yap</a>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            } else {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-circle-check text-success fs-4 mb-2 d-block"></i>
                            Tüm kurumlarımızda görevli atanmış durumdadır.
                        </td>
                    </tr>
                `;
            }
        } else {
            headerRow.innerHTML = `
                <th>Görevli Ad Soyad</th>
                <th>Atandığı Kurum</th>
                <th>Başlangıç / Bitiş</th>
                <th>Durum</th>
                <th class="text-end">İşlem</th>
            `;

            if (expiringGorevlendirmesData && expiringGorevlendirmesData.length > 0) {
                expiringGorevlendirmesData.forEach(g => {
                    const tr = document.createElement('tr');
                    const badgeClass = g.remainingDays <= 30 ? "bg-danger bg-opacity-10 text-danger" : "bg-warning bg-opacity-10 text-warning-emphasis";
                    
                    tr.innerHTML = `
                        <td>
                            <div class="fw-bold text-slate-900">${g.gorevliAdSoyad}</div>
                            <span class="text-muted small">${g.gorevliEmail}</span>
                        </td>
                        <td>
                            <div class="fw-bold text-slate-800">${g.kurumIsim}</div>
                            <span class="text-muted small">Bölge: ${g.kurumBolge}</span>
                        </td>
                        <td>
                            <div>${g.tarihFormatted}</div>
                            <div class="text-muted small">${g.bitisTarihiFormatted}</div>
                        </td>
                        <td>
                            <span class="badge ${badgeClass} px-2 py-1">
                                <i class="fa-solid fa-clock me-1"></i>Görev Süresi Azalıyor (${g.remainingDays} Gün Kaldı)
                            </span>
                        </td>
                        <td class="text-end">
                            <a href="/Gorevlendirme?targetKurumId=${g.kurumId}" class="btn btn-xs btn-outline-warning py-1 px-2" style="font-size: 0.75rem;"><i class="fa-solid fa-arrows-rotate me-1"></i>Yenile / Uzat</a>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            } else {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-circle-check text-success fs-4 mb-2 d-block"></i>
                            Süresi dolmak üzere olan görevlendirme bulunmamaktadır.
                        </td>
                    </tr>
                `;
            }
        }
    }

    function toggleVacancyView(view) {
        const btnUnstaffed = document.getElementById('btnShowUnstaffed');
        const btnExpiring = document.getElementById('btnShowExpiring');

        if (view === 'unstaffed') {
            btnUnstaffed.classList.add('active');
            btnExpiring.classList.remove('active');
        } else {
            btnUnstaffed.classList.remove('active');
            btnExpiring.classList.add('active');
        }

        renderVacancyGrid(view);
    }

    // Initialize initial view
    document.addEventListener("DOMContentLoaded", function() {
        renderVacancyGrid('unstaffed');
    });
</script>