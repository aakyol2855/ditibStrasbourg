@model DitibStasbourg.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-0">DITIB Strasbourg</h1>
            <p class="text-muted mb-0">Yönetim Paneli</p>
        </div>
        <button class="btn btn-sm btn-outline-secondary rounded-circle p-2" type="button" data-bs-toggle="modal" data-bs-target="#dashboardSettingsModal" title="Panel Ayarları">
            <i class="bi bi-gear-fill"></i>
        </button>
    </div>
    <div class="d-none d-md-block text-end text-muted small">
        <i class="bi bi-calendar-event me-1"></i> @DateTime.Now.ToString("dd MMMM yyyy, dddd")
    </div>
</div>

<!-- Interactive Command Center (Stats) -->
@await Component.InvokeAsync("Dashboard")

<!-- Modules Section -->
<h4 class="mb-4 fw-bold"><i class="bi bi-grid-1x2 me-2 text-primary"></i>Sistem Modülleri</h4>
<div class="row g-4">
    <!-- Dernekler Module -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden module-card transition-all" style="transition: transform 0.2s, box-shadow 0.2s;">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-3">
                        <i class="bi bi-building text-primary fs-3"></i>
                    </div>
                </div>
                <h5 class="card-title fw-bold">Dernek İşlemleri</h5>
                <p class="card-text text-muted mb-4">Dernek kayıtlarını yönetin, üyeleri, başkan bilgilerini ve bölgesel detayları güncelleyin.</p>
                <div class="mt-auto d-flex gap-2">
                    <a asp-controller="DernekIslemleri" asp-action="Index" class="btn btn-primary flex-grow-1">Listele / Git</a>
                    <a asp-controller="DernekIslemleri" asp-action="Create" class="btn btn-outline-primary" title="Yeni Ekle"><i class="bi bi-plus-lg"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Görevliler Module -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden module-card transition-all" style="transition: transform 0.2s, box-shadow 0.2s;">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="bg-success bg-opacity-10 p-3 rounded-3">
                        <i class="bi bi-person-badge text-success fs-3"></i>
                    </div>
                </div>
                <h5 class="card-title fw-bold">Görevli İşlemleri</h5>
                <p class="card-text text-muted mb-4">Sistemdeki din görevlilerini ve personeli yönetin. Durum, not ve izin takiplerini yapın.</p>
                <div class="mt-auto d-flex gap-2">
                    <a asp-controller="Gorevli" asp-action="Index" class="btn btn-success flex-grow-1">Listele / Git</a>
                    <a asp-controller="Gorevli" asp-action="Create" class="btn btn-outline-success" title="Yeni Ekle"><i class="bi bi-plus-lg"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Görevlendirmeler Module -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden module-card transition-all" style="transition: transform 0.2s, box-shadow 0.2s;">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="bg-warning bg-opacity-10 p-3 rounded-3">
                        <i class="bi bi-calendar-event text-warning fs-3"></i>
                    </div>
                </div>
                <h5 class="card-title fw-bold">Görevlendirmeler</h5>
                <p class="card-text text-muted mb-4">Görevlilerin derneklere atamalarını gerçekleştirin, tarih ve süre bazlı planlamalar yapın.</p>
                <div class="mt-auto d-flex gap-2">
                    <a asp-controller="Gorevlendirme" asp-action="Index" class="btn btn-warning flex-grow-1 text-dark">Listele / Git</a>
                    <a asp-controller="Gorevlendirme" asp-action="Create" class="btn btn-outline-warning text-dark" title="Yeni Ekle"><i class="bi bi-plus-lg"></i></a>
                </div>
            </div>
        </div>
    </div>

    @if (User.IsInRole("SuperAdmin"))
    {
        <!-- Sistem Tanımlamaları Module -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden module-card transition-all bg-light" style="transition: transform 0.2s, box-shadow 0.2s;">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="bg-secondary bg-opacity-10 p-3 rounded-3">
                            <i class="bi bi-gear-fill text-secondary fs-3"></i>
                        </div>
                        <span class="badge bg-secondary">Admin</span>
                    </div>
                    <h5 class="card-title fw-bold">Sistem Tanımlamaları</h5>
                    <p class="card-text text-muted mb-4">Sistemde kullanılan dinamik verileri (görev türleri, vb.) tanımlayın ve yönetin.</p>
                    <div class="mt-auto d-flex gap-2">
                        <a asp-controller="Tanimlamalar" asp-action="Index" class="btn btn-secondary flex-grow-1">Tanımlamalara Git</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .module-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>