@model DitibStasbourg.Models.Kurum

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0">@Model.Isim - Detay ve Yönetim</h5>
    </div>
    <div class="card-body">
        
        <!-- Tab Navigation -->
        <ul class="nav nav-tabs mb-3" id="tab-@Model.Id" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="info-tab-@Model.Id" data-bs-toggle="tab" data-bs-target="#info-@Model.Id" type="button">Genel Bilgiler</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="members-tab-@Model.Id" data-bs-toggle="tab" data-bs-target="#members-@Model.Id" type="button">
                    Üyeler <span class="badge bg-secondary">@(Model.DernekUyeleri?.Count ?? 0)</span>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="tabContent-@Model.Id">
            
                
                <div class="d-flex justify-content-end mb-2">
                    <form asp-action="Delete" asp-controller="DernekIslemleri" method="post" style="display:inline;" onsubmit="event.preventDefault(); if(confirm('@Model.Isim adlı derneği silmek istediğinizden emin misiniz?')) this.submit();">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i> Derneği Sil
                        </button>
                    </form>
                </div>

                <div class="accordion" id="accordion-@Model.Id">
                    
                    <!-- Dernek Temel Bilgileri -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading-dernek-@Model.Id">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-dernek-@Model.Id" aria-expanded="true">
                                <i class="fas fa-building me-2"></i> Dernek Temel Bilgileri
                            </button>
                        </h2>
                        <div id="collapse-dernek-@Model.Id" class="accordion-collapse collapse show" data-bs-parent="#accordion-@Model.Id">
                            <div class="accordion-body">
                                <form id="dernek-form-@Model.Id" onsubmit="event.preventDefault(); submitUpdateDernek(this, @Model.Id);">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label">Dernek Adı</label>
                                            <input type="text" name="isim" class="form-control" value="@Model.Isim" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Şehir</label>
                                            <input type="text" name="sehir" class="form-control" value="@Model.Sehir" />
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label">Adres</label>
                                            <textarea name="adres" class="form-control" rows="2">@Model.Adres</textarea>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Kuruluş Kanunu</label>
                                            <input type="text" name="kurulusKanunu" class="form-control" value="@Model.KurulusKanunu" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Başkonsolosluk Bölgesi</label>
                                            <input type="text" name="baskonsoloslukBolgesi" class="form-control" value="@Model.BaskonsoloslukBolgesi" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Bölge</label>
                                            <input type="text" name="bolge" class="form-control" value="@Model.Bolge" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">CRM Üyelik Form Durumu</label>
                                            <input type="text" name="crmUyelikFormDurumu" class="form-control" value="@Model.CrmUyelikFormDurumu" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Bağlı Olduğu Kurum</label>
                                            <select asp-for="UstKurumId" class="form-select" asp-items="@(new SelectList(ViewBag.KurumTurleri, "Id", "Ad"))">
                                                <option value="">Seçiniz</option>
                                            </select>
                                            <span asp-validation-for="UstKurumId" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-12">
                                            <button type="submit" class="btn btn-success">
                                                <i class="fas fa-save"></i> Temel Bilgileri Güncelle
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Başkan Bilgileri -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading-baskan-@Model.Id">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-baskan-@Model.Id">
                                <i class="fas fa-user-tie me-2"></i> Dernek Başkanı
                            </button>
                        </h2>
                        <div id="collapse-baskan-@Model.Id" class="accordion-collapse collapse" data-bs-parent="#accordion-@Model.Id">
                            <div class="accordion-body">
                                <form id="baskan-form-@Model.Id" onsubmit="event.preventDefault(); submitUpdateForm(this, @Model.Id, 'Başkan bilgileri');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <div class="mb-2">
                                        <label class="form-label">Ad Soyad</label>
                                        <input type="text" name="ad" class="form-control" value="@Model.DernekBaskaniAd" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">İletişim</label>
                                        <input type="text" name="iletisim" class="form-control" value="@Model.DernekBaskaniIletisim" />
                                    </div>
                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="fas fa-save"></i> Güncelle
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Din Görevlisi Bilgileri -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading-din-@Model.Id">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-din-@Model.Id">
                                <i class="fas fa-user me-2"></i> Din Görevlisi
                            </button>
                        </h2>
                        <div id="collapse-din-@Model.Id" class="accordion-collapse collapse" data-bs-parent="#accordion-@Model.Id">
                            <div class="accordion-body">
                                <form id="dingorevlisi-form-@Model.Id" onsubmit="event.preventDefault(); submitUpdateForm(this, @Model.Id, 'Din görevlisi bilgileri');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <div class="mb-2">
                                        <label class="form-label">Ad Soyad</label>
                                        <input type="text" name="ad" class="form-control" value="@Model.DinGorevlisiAd" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">İletişim</label>
                                        <input type="text" name="iletisim" class="form-control" value="@Model.DinGorevlisiIletisim" />
                                    </div>
                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="fas fa-save"></i> Güncelle
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Members Tab -->
            <div class="tab-pane fade" id="members-@Model.Id" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6>Üye Listesi @(Model.DernekUyeleri.Any() ? $"({Model.DernekUyeleri.Sum(u => u.AileUyeSayisi)} Aile Ferdi)" : "")</h6>
                    <button class="btn btn-sm btn-primary" onclick="toggleAddMember(@Model.Id)"><i class="fas fa-plus"></i> Üye Ekle</button>
                </div>

                <!-- Add Member Form (Hidden by default) -->
                <div id="add-member-form-@Model.Id" class="card mb-3 bg-light" style="display:none;">
                    <div class="card-body">
                        <form asp-action="AddUye" asp-controller="DernekIslemleri" method="post" onsubmit="event.preventDefault(); submitForm(this, @Model.Id);">
                            <input type="hidden" name="KurumId" value="@Model.Id" />
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label small">Ad Soyad</label>
                                    <input type="text" name="AdSoyad" class="form-control form-control-sm" required />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small">İletişim</label>
                                    <input type="text" name="Iletisim" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small">Aile Üye Sayısı</label>
                                    <input type="number" name="AileUyeSayisi" class="form-control form-control-sm" value="1" min="1" required />
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-sm btn-success w-100">Kaydet</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Ad Soyad</th>
                                <th>İletişim</th>
                                <th>Aile Sayısı</th>
                                <th>Kayıt Tarihi</th>
                                <th>İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DernekUyeleri != null && Model.DernekUyeleri.Any())
                            {
                                foreach (var uye in Model.DernekUyeleri.OrderByDescending(u => u.KayitTarihi))
                                {
                                    <tr id="member-row-@uye.Id">
                                        <td>
                                            <span id="display-adsoyad-@uye.Id">@uye.AdSoyad</span>
                                            <input type="text" id="edit-adsoyad-@uye.Id" class="form-control form-control-sm" value="@uye.AdSoyad" style="display:none;" />
                                        </td>
                                        <td>
                                            <span id="display-iletisim-@uye.Id">@uye.Iletisim</span>
                                            <input type="text" id="edit-iletisim-@uye.Id" class="form-control form-control-sm" value="@uye.Iletisim" style="display:none;" />
                                        </td>
                                        <td>
                                            <span id="display-ailesayisi-@uye.Id">@uye.AileUyeSayisi</span>
                                            <input type="number" id="edit-ailesayisi-@uye.Id" class="form-control form-control-sm" value="@uye.AileUyeSayisi" style="display:none;" />
                                        </td>
                                        <td>@uye.KayitTarihi.ToShortDateString()</td>
                                        <td>
                                            <button type="button" id="btn-edit-@uye.Id" class="btn btn-xs btn-warning" onclick="toggleEditMember(@uye.Id)">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button type="button" id="btn-save-@uye.Id" class="btn btn-xs btn-success" onclick="saveMember(@uye.Id, @Model.Id)" style="display:none;">
                                                <i class="fas fa-save"></i>
                                            </button>
                                            <button type="button" id="btn-cancel-@uye.Id" class="btn btn-xs btn-secondary" onclick="cancelEditMember(@uye.Id)" style="display:none;">
                                                <i class="fas fa-times"></i>
                                            </button>
                                            <form asp-action="DeleteUye" asp-controller="DernekIslemleri" method="post" style="display:inline;" onsubmit="event.preventDefault(); if(confirm('Silmek istediğine emin misin?')) submitForm(this, @Model.Id);">
                                                <input type="hidden" name="id" value="@uye.Id" />
                                                <button type="submit" class="btn btn-xs btn-danger"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">Henüz üye eklenmemiş.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

