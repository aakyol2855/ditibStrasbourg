@model DitibStasbourg.Models.Kurum

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0">@Model.Isim - Detay ve Yönetim</h5>
    </div>
    <div class="card-body">
        
        <!-- Tab Navigation -->
        <ul class="nav nav-tabs mb-3" id="tab-@Model.Id" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="info-tab-@Model.Id" data-bs-toggle="tab" data-bs-target="#info-@Model.Id" type="button">Genel Bilgiler</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="members-tab-@Model.Id" data-bs-toggle="tab" data-bs-target="#members-@Model.Id" type="button">
                    Üyeler <span class="badge bg-secondary">@(Model.DernekUyeleri?.Count ?? 0)</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="assignments-tab-@Model.Id" data-bs-toggle="tab" data-bs-target="#assignments-@Model.Id" type="button">
                    Görevliler ve Görev Geçmişi <span class="badge bg-secondary">@(Model.Gorevlendirmeler?.Count ?? 0)</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="board-tab-@Model.Id" data-bs-toggle="tab" data-bs-target="#board-@Model.Id" type="button">
                    Yönetim Kurulu <span class="badge bg-secondary">@(Model.YonetimKuruluUyeleri?.Count(u => !u.IsDeleted) ?? 0)</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="financial-tab-@Model.Id" data-bs-toggle="tab" data-bs-target="#financial-@Model.Id" type="button">
                    Finansal Dönemler <span class="badge bg-secondary">@(Model.FinansalDonemler?.Count ?? 0)</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="notes-tab-@Model.Id" data-bs-toggle="tab" data-bs-target="#notes-@Model.Id" type="button">
                    Notlar <span class="badge bg-secondary">@(Model.DernekNotlari?.Count(n => !n.IsDeleted) ?? 0)</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="gorsel-tab-@Model.Id" data-bs-toggle="tab" data-bs-target="#gorsel-@Model.Id" type="button">
                    Görseller <span class="badge bg-secondary">@(Model.DernekGorselleri?.Count(g => !g.IsDeleted) ?? 0)</span>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="tabContent-@Model.Id">
            
            <!-- Genel Bilgiler Tab Pane -->
            <div class="tab-pane fade show active" id="info-@Model.Id" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex gap-2">
                        <a href="/DernekIslemleri/ExportSingleToExcel/@Model.Id" class="btn btn-sm btn-success">
                            <i class="bi bi-file-earmark-excel me-1"></i> Excel İndir
                        </a>
                        <a href="/DernekIslemleri/Details/@Model.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye me-1"></i> Detaylı Görünüm
                        </a>
                        <a href="/DernekIslemleri/Edit/@Model.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil me-1"></i> Düzenle
                        </a>
                    </div>
                    <form asp-action="Delete" asp-controller="DernekIslemleri" method="post" style="display:inline;" onsubmit="event.preventDefault(); if(confirm('@Model.Isim adlı derneği silmek istediğinizden emin misiniz?')) this.submit();">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i> Derneği Sil
                        </button>
                    </form>
                </div>

                <div class="accordion" id="accordion-@Model.Id">
                    
                    <!-- Dernek Temel Bilgileri -->
                    <div class="accordion-item border-0 shadow-xs mb-2 rounded">
                        <h2 class="accordion-header" id="heading-dernek-@Model.Id">
                            <button class="accordion-button bg-light text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-dernek-@Model.Id" aria-expanded="true">
                                <i class="fas fa-building me-2 text-primary"></i> Dernek Temel Bilgileri
                            </button>
                        </h2>
                        <div id="collapse-dernek-@Model.Id" class="accordion-collapse collapse show" data-bs-parent="#accordion-@Model.Id">
                            <div class="accordion-body bg-white">
                                <dl class="row mb-0 g-2">
                                    <dt class="col-sm-3 text-muted small">Dernek Adı</dt>
                                    <dd class="col-sm-9 fw-bold">@Model.Isim</dd>

                                    <dt class="col-sm-3 text-muted small">Şehir</dt>
                                    <dd class="col-sm-9">@(Model.Sehir ?? "-")</dd>

                                    <dt class="col-sm-3 text-muted small">Adres</dt>
                                    <dd class="col-sm-9">@(Model.Adres ?? "-")</dd>

                                    <dt class="col-sm-3 text-muted small">Kuruluş Kanunu</dt>
                                    <dd class="col-sm-9">
                                        @if (!string.IsNullOrEmpty(Model.KurulusKanunu))
                                        {
                                            @Model.KurulusKanunu
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Belirtilmemiş</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-3 text-muted small">Başkonsolosluk Bölgesi</dt>
                                    <dd class="col-sm-9">@(Model.BaskonsoloslukBolgesi ?? "-")</dd>

                                    <dt class="col-sm-3 text-muted small">Bölge</dt>
                                    <dd class="col-sm-9">@(Model.Bolge ?? "-")</dd>

                                    <dt class="col-sm-3 text-muted small">CRM Üyelik Form Durumu</dt>
                                    <dd class="col-sm-9">
                                        @if (!string.IsNullOrEmpty(Model.CrmUyelikFormDurumu))
                                        {
                                            <span class="badge bg-info text-dark">@Model.CrmUyelikFormDurumu</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-3 text-muted small">Bağlı Olduğu Üst Kurum</dt>
                                    <dd class="col-sm-9">@(Model.UstKurum?.Ad ?? "Bağımsız")</dd>

                                    <dt class="col-sm-3 text-muted small">İletişim Numarası</dt>
                                    <dd class="col-sm-9">@(Model.IletisimNumarasi ?? "-")</dd>

                                    <dt class="col-sm-3 text-muted small">Dernek E-posta</dt>
                                    <dd class="col-sm-9">@(Model.Maili ?? "-")</dd>

                                    <dt class="col-sm-3 text-muted small">Resmi Fransızca Adı</dt>
                                    <dd class="col-sm-9">@(Model.FrenchRegistrationName ?? "-")</dd>

                                    <dt class="col-sm-3 text-muted small">Cemaat Sayısı</dt>
                                    <dd class="col-sm-9">
                                        @if (Model.CemaatCount.HasValue)
                                        {
                                            @Model.CemaatCount.Value
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Belirtilmemiş</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-3 text-muted small">IBAN Numarası</dt>
                                    <dd class="col-sm-9">
                                        @if (!string.IsNullOrEmpty(Model.IbanNo))
                                        {
                                            @Model.IbanNo
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Belirtilmemiş</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-3 text-muted small">SIRET Numarası</dt>
                                    <dd class="col-sm-9">
                                        @if (!string.IsNullOrEmpty(Model.SiretNo))
                                        {
                                            @Model.SiretNo
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Belirtilmemiş</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-3 text-muted small">RNA Numarası</dt>
                                    <dd class="col-sm-9">
                                        @if (!string.IsNullOrEmpty(Model.RnaNo))
                                        {
                                            @Model.RnaNo
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Belirtilmemiş</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-3 text-muted small">Ekonomi Notu</dt>
                                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.EkonomiNotu) ? "-" : Model.EkonomiNotu)</dd>

                                    <dt class="col-sm-3 text-muted small">Coğrafi Konum (Enlem / Boylam)</dt>
                                    <dd class="col-sm-9">
                                        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                                        {
                                            <span>@Model.Latitude.Value / @Model.Longitude.Value</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic small">Belirtilmemiş</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-3 text-muted small">Cami / İbadethane</dt>
                                    <dd class="col-sm-9">
                                        <span class="badge @(Model.HasCami ? "bg-success-soft text-success" : "bg-light text-muted")">
                                            @(Model.HasCami ? "Mevcut" : "Yok")
                                        </span>
                                    </dd>

                                    <dt class="col-sm-3 text-muted small">Lojman Bilgisi</dt>
                                    <dd class="col-sm-9">
                                        <span class="badge @(Model.HasLojman ? "bg-success-soft text-success" : "bg-light text-muted")">
                                            @(Model.HasLojman ? $"Mevcut (Kapasite: {Model.LojmanKapasite ?? 0} Kişi)" : "Yok")
                                        </span>
                                    </dd>

                                    <dt class="col-sm-3 text-muted small">Müştemilat Bilgisi</dt>
                                    <dd class="col-sm-9">
                                        <span class="badge @(Model.HasMustemilat ? "bg-success-soft text-success" : "bg-light text-muted")">
                                            @(Model.HasMustemilat ? $"Mevcut (Kapasite: {Model.MustemilatKapasite ?? 0} Kişi)" : "Yok")
                                        </span>
                                    </dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <!-- Başkan Bilgileri -->
                    <div class="accordion-item border-0 shadow-xs mb-2 rounded">
                        <h2 class="accordion-header" id="heading-baskan-@Model.Id">
                            <button class="accordion-button collapsed bg-light text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-baskan-@Model.Id">
                                <i class="fas fa-user-tie me-2 text-info"></i> Dernek Başkanı
                            </button>
                        </h2>
                        <div id="collapse-baskan-@Model.Id" class="accordion-collapse collapse" data-bs-parent="#accordion-@Model.Id">
                            <div class="accordion-body bg-white">
                                <dl class="row mb-0 g-2">
                                    <dt class="col-sm-3 text-muted small">Ad Soyad</dt>
                                    <dd class="col-sm-9 fw-bold">@(Model.DernekBaskaniAd ?? "-")</dd>

                                    <dt class="col-sm-3 text-muted small">İletişim</dt>
                                    <dd class="col-sm-9">@(Model.DernekBaskaniIletisim ?? "-")</dd>

                                    <dt class="col-sm-3 text-muted small">Başkan E-posta</dt>
                                    <dd class="col-sm-9">@(Model.BaskanMail ?? "-")</dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <!-- Din Görevlisi Bilgileri -->
                    <div class="accordion-item border-0 shadow-xs mb-2 rounded">
                        <h2 class="accordion-header" id="heading-din-@Model.Id">
                            <button class="accordion-button collapsed bg-light text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-din-@Model.Id">
                                <i class="fas fa-user me-2 text-success"></i> Din Görevlisi
                            </button>
                        </h2>
                        <div id="collapse-din-@Model.Id" class="accordion-collapse collapse" data-bs-parent="#accordion-@Model.Id">
                            <div class="accordion-body bg-white">
                                <dl class="row mb-0 g-2">
                                    <dt class="col-sm-3 text-muted small">Ad Soyad</dt>
                                    <dd class="col-sm-9 fw-bold">@(Model.DinGorevlisiAd ?? "-")</dd>

                                    <dt class="col-sm-3 text-muted small">İletişim</dt>
                                    <dd class="col-sm-9">@(Model.DinGorevlisiIletisim ?? "-")</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Members Tab -->
            <div class="tab-pane fade" id="members-@Model.Id" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6>Üye Listesi @(Model.DernekUyeleri != null && Model.DernekUyeleri.Any() ? $"({Model.DernekUyeleri.Sum(u => u.AileUyeSayisi)} Aile Ferdi)" : "")</h6>
                    <button class="btn btn-sm btn-primary" onclick="toggleAddMember(@Model.Id)"><i class="fas fa-plus"></i> Üye Ekle</button>
                </div>

                <!-- Add Member Form (Hidden by default) -->
                <div id="add-member-form-@Model.Id" class="card mb-3 bg-light" style="display:none;">
                    <div class="card-body">
                        <form asp-action="AddUye" asp-controller="DernekIslemleri" method="post" onsubmit="event.preventDefault(); submitForm(this, @Model.Id);">
                            <input type="hidden" name="KurumId" value="@Model.Id" />
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label small">Ad Soyad</label>
                                    <input type="text" name="AdSoyad" class="form-control form-control-sm" required />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small">İletişim</label>
                                    <input type="text" name="Iletisim" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small">Aile Üye Sayısı</label>
                                    <input type="number" name="AileUyeSayisi" class="form-control form-control-sm" value="1" min="1" required />
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-sm btn-success w-100">Kaydet</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Ad Soyad</th>
                                <th>İletişim</th>
                                <th>Aile Sayısı</th>
                                <th>Kayıt Tarihi</th>
                                <th>İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DernekUyeleri != null && Model.DernekUyeleri.Any())
                            {
                                foreach (var uye in Model.DernekUyeleri.OrderByDescending(u => u.KayitTarihi))
                                {
                                    <tr id="member-row-@uye.Id">
                                        <td>
                                            <span id="display-adsoyad-@uye.Id">@uye.AdSoyad</span>
                                            <input type="text" id="edit-adsoyad-@uye.Id" class="form-control form-control-sm" value="@uye.AdSoyad" style="display:none;" />
                                        </td>
                                        <td>
                                            <span id="display-iletisim-@uye.Id">@uye.Iletisim</span>
                                            <input type="text" id="edit-iletisim-@uye.Id" class="form-control form-control-sm" value="@uye.Iletisim" style="display:none;" />
                                        </td>
                                        <td>
                                            <span id="display-ailesayisi-@uye.Id">@uye.AileUyeSayisi</span>
                                            <input type="number" id="edit-ailesayisi-@uye.Id" class="form-control form-control-sm" value="@uye.AileUyeSayisi" style="display:none;" />
                                        </td>
                                        <td>@uye.KayitTarihi.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            <button type="button" id="btn-edit-@uye.Id" class="btn btn-xs btn-warning" onclick="toggleEditMember(@uye.Id)">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button type="button" id="btn-save-@uye.Id" class="btn btn-xs btn-success" onclick="saveMember(@uye.Id, @Model.Id)" style="display:none;">
                                                <i class="fas fa-save"></i>
                                            </button>
                                            <button type="button" id="btn-cancel-@uye.Id" class="btn btn-xs btn-secondary" onclick="cancelEditMember(@uye.Id)" style="display:none;">
                                                <i class="fas fa-times"></i>
                                            </button>
                                            <form asp-action="DeleteUye" asp-controller="DernekIslemleri" method="post" style="display:inline;" onsubmit="event.preventDefault(); if(confirm('Silmek istediğine emin misin?')) submitForm(this, @Model.Id);">
                                                <input type="hidden" name="id" value="@uye.Id" />
                                                <button type="submit" class="btn btn-xs btn-danger"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">Henüz üye eklenmemiş.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Görevliler ve Görev Geçmişi Tab Pane -->
            <div class="tab-pane fade" id="assignments-@Model.Id" role="tabpanel">
                <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Görevli Adı Soyadı</th>
                                <th>Başlangıç Tarihi</th>
                                <th>Bitiş Tarihi</th>
                                <th>Görev / İdari Notları</th>
                                <th style="width: 100px;" class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Gorevlendirmeler != null && Model.Gorevlendirmeler.Any())
                            {
                                foreach (var gv in Model.Gorevlendirmeler.OrderByDescending(g => g.Tarih))
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-dark">@(gv.Gorevli != null ? $"{gv.Gorevli.Ad} {gv.Gorevli.Soyad}" : "Belirtilmemiş")</span>
                                        </td>
                                        <td>@gv.Tarih.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            @if (gv.BitisTarihi.HasValue)
                                            {
                                                @gv.BitisTarihi.Value.ToString("dd.MM.yyyy")
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Görev Devam Ediyor</span>
                                            }
                                        </td>
                                        <td>
                                            @if (gv.GorevlendirmeNotlari != null && gv.GorevlendirmeNotlari.Any())
                                            {
                                                <ul class="list-unstyled mb-0 small text-muted">
                                                    @foreach (var not in gv.GorevlendirmeNotlari.OrderByDescending(n => n.Tarih))
                                                    {
                                                        <li>• @not.NotIcerik <span class="text-black-50">(@not.Tarih.ToString("dd.MM.yyyy"))</span></li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic small">-</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a href="/Gorevli/Details/@gv.GorevliId" class="btn btn-xs btn-primary text-nowrap">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>Detaya Git
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">Bu derneğe atanmış görevli geçmişi bulunmuyor.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Yönetim Kurulu Tab Pane -->
            <div class="tab-pane fade" id="board-@Model.Id" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-people-fill me-1 text-primary"></i> Yönetim Kurulu Üyeleri</h6>
                    <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#addBoardMemberCollapse-@Model.Id" aria-expanded="false">
                        <i class="bi bi-plus-lg me-1"></i>Üye Ekle
                    </button>
                </div>

                <!-- Inline Add Form -->
                <div class="collapse mb-3" id="addBoardMemberCollapse-@Model.Id">
                    <div class="card border-0 bg-light">
                        <div class="card-body">
                            <form asp-action="AddBoardMember" asp-controller="DernekIslemleri" method="post" id="addBoardForm-@Model.Id">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="KurumId" value="@Model.Id" />
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Ad Soyad <span class="text-danger">*</span></label>
                                        <input type="text" name="FullName" class="form-control form-control-sm" required placeholder="örn. Ahmet Yılmaz" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold">İletişim Telefonu</label>
                                        <input type="text" name="ContactPhone" class="form-control form-control-sm" placeholder="+33 6..." />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold">Yönetim Rolü <span class="text-danger">*</span></label>
                                        <select name="YonetimRolId" class="form-select form-select-sm" required>
                                            <option value="">Seçiniz...</option>
                                            @if (ViewBag.YonetimRolleri != null)
                                            {
                                                foreach (var rol in (IEnumerable<DitibStasbourg.Models.Ref_YonetimRol>)ViewBag.YonetimRolleri)
                                                {
                                                    <option value="@rol.Id">@rol.Ad</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-sm btn-success w-100"><i class="bi bi-save me-1"></i>Kaydet</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                    <table class="table table-sm table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Ad Soyad</th>
                                <th>İletişim Telefonu</th>
                                <th>Görevi / Yönetim Rolü</th>
                                <th class="text-center">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var activeMembers = Model.YonetimKuruluUyeleri?.Where(u => !u.IsDeleted).ToList();
                            }
                            @if (activeMembers != null && activeMembers.Any())
                            {
                                foreach (var member in activeMembers)
                                {
                                    <tr>
                                        <td><span class="fw-bold text-dark">@member.FullName</span></td>
                                        <td>@(member.ContactPhone ?? "-")</td>
                                        <td>
                                            <span class="badge bg-secondary">@(member.YonetimRol?.Ad ?? "Belirtilmemiş")</span>
                                        </td>
                                        <td class="text-center">
                                            <form asp-action="DeleteBoardMember" asp-controller="DernekIslemleri" method="post" style="display:inline;"
                                                  onsubmit="return confirm('@member.FullName adlı üyeyi yönetim kurulundan çıkarmak istediğinizden emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@member.Id" />
                                                <input type="hidden" name="kurumId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-xs btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">
                                        Bu derneğin yönetim kurulu kaydı bulunmuyor. Yukarıdaki "Üye Ekle" butonunu kullanın.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Finansal Dönemler Tab Pane -->
            <div class="tab-pane fade" id="financial-@Model.Id" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0 text-primary fw-bold"><i class="bi bi-cash-coin me-1"></i> Fıtre, Zekat ve Fidye Bilançoları</h6>
                    <button type="button" class="btn btn-sm btn-success rounded-pill px-3" onclick="toggleAddFinancial(@Model.Id)">
                        <i class="bi bi-plus-lg me-1"></i> Yeni Dönem Ekle
                    </button>
                </div>

                <!-- Add Financial Period form -->
                <div id="add-financial-form-@Model.Id" class="card bg-light border-0 mb-3" style="display:none; border-radius: 0.75rem;">
                    <div class="card-body">
                        <form id="financialForm-@Model.Id" onsubmit="event.preventDefault(); submitAddFinancial(this, @Model.Id);">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="KurumId" value="@Model.Id" />
                            <div class="row g-2">
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold">Yıl</label>
                                    <input type="number" name="Year" class="form-control form-control-sm" required min="2000" max="2100" value="@DateTime.Now.Year" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">Kampanya Türü</label>
                                    <select name="CampaignType" class="form-select form-select-sm" required>
                                        <option value="0">Fitre</option>
                                        <option value="1">Zekat</option>
                                        <option value="2">Fidye</option>
                                        <option value="3">GenelNakit</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">Miktar (€)</label>
                                    <input type="number" step="0.01" name="CollectedAmount" class="form-control form-control-sm" required min="0" value="0.00" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small fw-bold">Döviz</label>
                                    <input type="text" name="Currency" class="form-control form-control-sm" value="EUR" required />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label small fw-bold">Dahili Notlar</label>
                                    <input type="text" name="InternalNotes" class="form-control form-control-sm" placeholder="İsteğe bağlı not..." />
                                </div>
                                <div class="col-md-12 text-end mt-2">
                                    <button type="submit" class="btn btn-sm btn-primary px-3 rounded-pill">
                                        <i class="bi bi-save me-1"></i> Kaydet
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-hover table-striped align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>Yıl</th>
                                <th>Kampanya Türü</th>
                                <th class="text-end">Toplanan Tutar</th>
                                <th>Notlar</th>
                                <th class="text-center">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.FinansalDonemler != null && Model.FinansalDonemler.Any())
                            {
                                foreach (var fd in Model.FinansalDonemler.OrderByDescending(f => f.Year).ThenBy(f => f.CampaignType))
                                {
                                    <tr>
                                        <td class="fw-bold">@fd.Year</td>
                                        <td>
                                            <span class="badge @(fd.CampaignType == CampaignType.Fitre ? "bg-info" : fd.CampaignType == CampaignType.Zekat ? "bg-success" : fd.CampaignType == CampaignType.Fidye ? "bg-warning text-dark" : "bg-secondary")">
                                                @fd.CampaignType.ToString()
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold">@fd.CollectedAmount.ToString("C2", new System.Globalization.CultureInfo("fr-FR"))</td>
                                        <td>@(fd.InternalNotes ?? "-")</td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="deleteFinancial(@fd.Id, @Model.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">Bu dernek için henüz dönemsel finansal kayıt bulunmamaktadır.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Notlar Tab Pane -->
            <div class="tab-pane fade" id="notes-@Model.Id" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-chat-left-text-fill text-primary me-2"></i>Dernek Notları</h6>
                    <button class="btn btn-sm btn-primary rounded-pill px-3" onclick="toggleAddNoteForm(@Model.Id)">
                        <i class="bi bi-plus-circle me-1"></i> Yeni Not Ekle
                    </button>
                </div>

                <!-- Add Note Form -->
                <div id="add-note-form-@Model.Id" class="card bg-light border-0 mb-3" style="display:none; border-radius: 0.75rem;">
                    <div class="card-body">
                        <form id="noteForm-@Model.Id" onsubmit="event.preventDefault(); submitAddNote(this, @Model.Id);">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="dernekId" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Not İçeriği</label>
                                <textarea name="content" class="form-control" rows="3" required placeholder="Notunuzu buraya yazın..."></textarea>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Hatırlatma / Bitiş Tarihi (İsteğe Bağlı)</label>
                                    <input type="date" name="bitisTarihi" class="form-control" />
                                    <small class="text-muted">Bu tarih yaklaştığında sistem bildirim kutusuna otomatik uyarı düşecektir.</small>
                                </div>
                                <div class="col-md-6 text-end align-self-end">
                                    <button type="submit" class="btn btn-sm btn-primary px-3 rounded-pill">
                                        <i class="bi bi-save me-1"></i> Kaydet
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="list-group list-group-flush" id="notes-list-@Model.Id">
                    @if (Model.DernekNotlari != null && Model.DernekNotlari.Any(n => !n.IsDeleted))
                    {
                        foreach (var note in Model.DernekNotlari.Where(n => !n.IsDeleted).OrderByDescending(n => n.KayitTarihi))
                        {
                            <div class="list-group-item py-3 border-0 bg-transparent" id="note-item-@note.Id">
                                <div class="d-flex w-100 justify-content-between align-items-start">
                                    <div class="pe-3">
                                        <p class="mb-1 text-dark text-break">@note.NotIcerigi</p>
                                        <div class="d-flex flex-wrap gap-3 align-items-center mt-2 small text-muted">
                                            <span><i class="bi bi-person me-1"></i>@note.EkleyenKullanici</span>
                                            <span><i class="bi bi-calendar-event me-1"></i>@note.KayitTarihi.ToString("dd.MM.yyyy HH:mm")</span>
                                            @if (note.BitisTarihi.HasValue)
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill">
                                                    <i class="bi bi-alarm me-1"></i>Hatırlatma: @note.BitisTarihi.Value.ToString("dd.MM.yyyy")
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle" onclick="deleteDernekNote(@note.Id, @Model.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">Bu dernek için henüz not alınmamış.</div>
                    }
                </div>
            </div>

            <!-- Görseller Tab Pane -->
            <div class="tab-pane fade" id="gorsel-@Model.Id" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-images text-primary me-2"></i>Dernek Görselleri (Cami, Lojman, Müştemilat)</h6>
                    <button class="btn btn-sm btn-primary rounded-pill px-3" onclick="toggleAddGorselForm(@Model.Id)">
                        <i class="bi bi-plus-circle me-1"></i> Yeni Görsel Yükle
                    </button>
                </div>

                <!-- Add Visual Form -->
                <div id="add-gorsel-form-@Model.Id" class="card bg-light border-0 mb-4" style="display:none; border-radius: 0.75rem;">
                    <div class="card-body">
                        <form id="gorselForm-@Model.Id" enctype="multipart/form-data" onsubmit="event.preventDefault(); submitAddGorsel(this, @Model.Id);">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="dernekId" value="@Model.Id" />
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Görsel Seçin</label>
                                    <input type="file" name="file" class="form-control form-control-sm" accept=".jpg,.jpeg,.png" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Görsel Kategorisi</label>
                                    <select name="type" class="form-select form-select-sm" required>
                                        <option value="0">Cami</option>
                                        <option value="1">Lojman</option>
                                        <option value="2">Müştemilat</option>
                                        <option value="3">Dış Cephe</option>
                                        <option value="4">Diğer</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Açıklama</label>
                                    <input type="text" name="description" class="form-control form-control-sm" placeholder="örn. Lojman giriş kat salonu..." />
                                </div>
                                <div class="col-md-12 text-end">
                                    <button type="submit" class="btn btn-sm btn-primary px-3 rounded-pill">
                                        <i class="bi bi-cloud-upload me-1"></i> Görseli Yükle
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="row g-3" id="gorseller-grid-@Model.Id">
                    @if (Model.DernekGorselleri != null && Model.DernekGorselleri.Any(g => !g.IsDeleted))
                    {
                        foreach (var gorsel in Model.DernekGorselleri.Where(g => !g.IsDeleted).OrderByDescending(g => g.YuklenmeTarihi))
                        {
                            <div class="col-md-4 col-sm-6" id="gorsel-item-@gorsel.Id">
                                <div class="card h-100 shadow-sm border-0 overflow-hidden" style="border-radius: 0.75rem;">
                                    <a href="@gorsel.GorselYolu" target="_blank">
                                        <img src="@gorsel.GorselYolu" class="card-img-top" style="height: 160px; object-fit: cover;" alt="@gorsel.Aciklama" />
                                    </a>
                                    <div class="card-body p-2 d-flex flex-column justify-content-between">
                                        <div>
                                            <span class="badge bg-secondary mb-1">@gorsel.GorselTipi.ToString()</span>
                                            <p class="card-text small text-dark mb-1">@(gorsel.Aciklama ?? "Açıklama yok")</p>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-2">
                                            <small class="text-muted small" style="font-size: 0.75rem;">@gorsel.YuklenmeTarihi.ToString("dd.MM.yyyy")</small>
                                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="deleteDernekGorsel(@gorsel.Id, @Model.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center text-muted py-4">Bu dernek için henüz görsel yüklenmemiş.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    if (typeof window.dernekDetayScriptsLoaded === 'undefined') {
        window.dernekDetayScriptsLoaded = true;

        window.toggleAddNoteForm = function(dernekId) {
            var form = document.getElementById('add-note-form-' + dernekId);
            if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
        };

        window.toggleAddGorselForm = function(dernekId) {
            var form = document.getElementById('add-gorsel-form-' + dernekId);
            if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
        };

        window.submitAddNote = function(formElement, dernekId) {
            var formData = new FormData(formElement);
            fetch('/DernekIslemleri/AddDernekNot', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('✓ ' + data.message);
                    if (typeof reloadDetails === 'function') {
                        reloadDetails(dernekId);
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert('✗ Hata: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('✗ Sunucu bağlantısı başarısız.');
            });
        };

        window.deleteDernekNote = function(noteId, dernekId) {
            if (!confirm('Bu notu silmek istediğinizden emin misiniz?')) return;
            var formData = new FormData();
            formData.append('id', noteId);
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            formData.append('__RequestVerificationToken', token);

            fetch('/DernekIslemleri/DeleteDernekNot', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('✓ ' + data.message);
                    if (typeof reloadDetails === 'function') {
                        reloadDetails(dernekId);
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert('✗ Hata: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('✗ Sunucu bağlantısı başarısız.');
            });
        };

        window.submitAddGorsel = function(formElement, dernekId) {
            var grid = document.getElementById('gorseller-grid-' + dernekId);
            if (grid) {
                var images = grid.querySelectorAll('[id^="gorsel-item-"]');
                if (images && images.length >= 5) {
                    alert('✗ En fazla 5 görsel yükleyebilirsiniz. Yeni yüklemek için lütfen önce eski bir görseli silin.');
                    return;
                }
            }
            var formData = new FormData(formElement);
            fetch('/DernekIslemleri/AddDernekGorsel', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('✓ ' + data.message);
                    if (typeof reloadDetails === 'function') {
                        reloadDetails(dernekId);
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert('✗ Hata: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('✗ Sunucu bağlantısı başarısız.');
            });
        };

        window.deleteDernekGorsel = function(gorselId, dernekId) {
            if (!confirm('Bu görseli silmek istediğinizden emin misiniz?')) return;
            var formData = new FormData();
            formData.append('id', gorselId);
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            formData.append('__RequestVerificationToken', token);

            fetch('/DernekIslemleri/DeleteDernekGorsel', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('✓ ' + data.message);
                    if (typeof reloadDetails === 'function') {
                        reloadDetails(dernekId);
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert('✗ Hata: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('✗ Sunucu bağlantısı başarısız.');
            });
        };
    }
</script>
