@model DitibStasbourg.Models.Kurum

@{
    ViewData["Title"] = "Yeni Dernek Ekle";
}

<div class="container">
    <h1>Yeni Dernek Ekle</h1>
    <hr />

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <!-- Temel Bilgiler -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-building me-2"></i>Temel Bilgiler</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Isim" class="form-label"></label>
                            <input asp-for="Isim" class="form-control" required />
                            <span asp-validation-for="Isim" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Sehir" class="form-label"></label>
                            <select asp-for="Sehir" class="form-select select2-city">
                                <option value="">Seçiniz veya yeni yazınız...</option>
                                @if (ViewBag.Sehirler != null)
                                {
                                    foreach (var sehir in (List<string>)ViewBag.Sehirler)
                                    {
                                        <option value="@sehir">@sehir</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Sehir" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Adres" class="form-label"></label>
                            <textarea asp-for="Adres" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Adres" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UstKurumId" class="form-label"></label>
                            <select asp-for="UstKurumId" class="form-select">
                                <option value="">Bağımsız</option>
                                @if (ViewBag.UstKurumlar != null)
                                {
                                    foreach (var kurum in (List<DitibStasbourg.Models.Ref_KurumTuru>)ViewBag.UstKurumlar)
                                    {
                                        <option value="@kurum.Id">@kurum.Ad</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="UstKurumId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Yönetim Bilgileri -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-users me-2"></i>Yönetim Bilgileri</h5>
                    </div>
                    <div class="card-body">
                        <strong class="d-block mb-2">Dernek Başkanı</strong>
                        <div class="mb-2">
                            <label asp-for="DernekBaskaniAd" class="form-label small">Ad Soyad</label>
                            <input asp-for="DernekBaskaniAd" class="form-control" />
                            <span asp-validation-for="DernekBaskaniAd" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DernekBaskaniIletisim" class="form-label small">İletişim</label>
                            <input asp-for="DernekBaskaniIletisim" class="form-control" />
                            <span asp-validation-for="DernekBaskaniIletisim" class="text-danger"></span>
                        </div>

                        <hr />

                        <strong class="d-block mb-2">Din Görevlisi</strong>
                        <div class="mb-2">
                            <label asp-for="DinGorevlisiAd" class="form-label small">Ad Soyad</label>
                            <input asp-for="DinGorevlisiAd" class="form-control" />
                            <span asp-validation-for="DinGorevlisiAd" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DinGorevlisiIletisim" class="form-label small">İletişim</label>
                            <input asp-for="DinGorevlisiIletisim" class="form-control" />
                            <span asp-validation-for="DinGorevlisiIletisim" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ek Bilgiler -->
            <div class="col-md-12 mb-4">
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Ek Bilgiler</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="BaskonsoloslukBolgesi" class="form-label"></label>
                                <input asp-for="BaskonsoloslukBolgesi" class="form-control" />
                                <span asp-validation-for="BaskonsoloslukBolgesi" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Bolge" class="form-label"></label>
                                <input asp-for="Bolge" class="form-control" />
                                <span asp-validation-for="Bolge" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="KurulusKanunu" class="form-label"></label>
                                <input asp-for="KurulusKanunu" class="form-control" />
                                <span asp-validation-for="KurulusKanunu" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CrmUyelikFormDurumu" class="form-label"></label>
                                <select asp-for="CrmUyelikFormDurumu" class="form-select">
                                    <option value="">Seçiniz</option>
                                    <option value="Var">Var</option>
                                    <option value="Yok">Yok</option>
                                    <option value="Beklemede">Beklemede</option>
                                </select>
                                <span asp-validation-for="CrmUyelikFormDurumu" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-3">
            <button type="submit" class="btn btn-primary btn-lg px-5">
                <i class="fas fa-save me-2"></i>Kaydet
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-lg">
                <i class="fas fa-times me-2"></i>İptal
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Initialize Select2 for city selection with tags support (allows new entries)
            $('.select2-city').select2({
                tags: true,
                placeholder: 'Seçiniz veya yeni şehir yazınız...',
                allowClear: true
            });
        });
    </script>
}
