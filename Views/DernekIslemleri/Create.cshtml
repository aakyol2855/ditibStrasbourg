@model DitibStasbourg.Models.Kurum

@{
    ViewData["Title"] = "Yeni Dernek Ekle";
}
@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}
<div class="container">
    <h1>Yeni Dernek Ekle</h1>
    <hr />

    <form asp-action="Create" method="post" id="createForm">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row">
            <!-- Temel Bilgiler -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-building me-2"></i>Temel Bilgiler</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Isim" class="form-label">Dernek / Kurum Adı <span class="text-danger">*</span></label>
                            <input asp-for="Isim" class="form-control" required />
                            <span asp-validation-for="Isim" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Sehir" class="form-label"></label>
                            <select asp-for="Sehir" class="form-select select2-city">
                                <option value="">Seçiniz veya yeni yazınız...</option>
                                @if (ViewBag.Sehirler != null)
                                {
                                    foreach (var sehir in (List<string>)ViewBag.Sehirler)
                                    {
                                        <option value="@sehir">@sehir</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Sehir" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Adres" class="form-label"></label>
                            <textarea asp-for="Adres" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Adres" class="text-danger"></span>
                        </div>

                         <div class="mb-3">
                            <label asp-for="UstKurumId" class="form-label"></label>
                            <select asp-for="UstKurumId" class="form-select">
                                <option value="">Bağımsız</option>
                                @if (ViewBag.UstKurumlar != null)
                                {
                                    foreach (var kurum in (List<DitibStasbourg.Models.Ref_KurumTuru>)ViewBag.UstKurumlar)
                                    {
                                        <option value="@kurum.Id">@kurum.Ad</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="UstKurumId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IletisimNumarasi" class="form-label"></label>
                            <input asp-for="IletisimNumarasi" class="form-control" placeholder="+33..." />
                            <span asp-validation-for="IletisimNumarasi" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Maili" class="form-label"></label>
                            <input asp-for="Maili" class="form-control" type="email" placeholder="example@domain.com" />
                            <span asp-validation-for="Maili" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IbanNo" class="form-label">IBAN No <span class="text-danger">*</span></label>
                            <input asp-for="IbanNo" class="form-control" placeholder="FR76..." required />
                            <span asp-validation-for="IbanNo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SiretNo" class="form-label">SIRET No <span class="text-danger">*</span></label>
                            <input asp-for="SiretNo" class="form-control" placeholder="14 haneli numara" required />
                            <span asp-validation-for="SiretNo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RnaNo" class="form-label">RNA No <span class="text-danger">*</span></label>
                            <input asp-for="RnaNo" class="form-control" placeholder="W..." required />
                            <span asp-validation-for="RnaNo" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Yönetim Bilgileri -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-users me-2"></i>Yönetim Bilgileri</h5>
                    </div>
                    <div class="card-body">
                        <strong class="d-block mb-2">Dernek Başkanı</strong>
                        <div class="mb-2">
                            <label asp-for="DernekBaskaniAd" class="form-label small">Ad Soyad</label>
                            <input asp-for="DernekBaskaniAd" class="form-control" />
                            <span asp-validation-for="DernekBaskaniAd" class="text-danger"></span>
                        </div>
                        <div class="mb-2">
                            <label asp-for="DernekBaskaniIletisim" class="form-label small">İletişim</label>
                            <input asp-for="DernekBaskaniIletisim" class="form-control" />
                            <span asp-validation-for="DernekBaskaniIletisim" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="BaskanMail" class="form-label small">Başkan E-posta</label>
                            <input asp-for="BaskanMail" class="form-control" type="email" />
                            <span asp-validation-for="BaskanMail" class="text-danger"></span>
                        </div>

                        <hr />

                        <strong class="d-block mb-2">Din Görevlisi</strong>
                        <div class="mb-2">
                            <label asp-for="DinGorevlisiAd" class="form-label small">Ad Soyad</label>
                            <input asp-for="DinGorevlisiAd" class="form-control" />
                            <span asp-validation-for="DinGorevlisiAd" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DinGorevlisiIletisim" class="form-label small">İletişim</label>
                            <input asp-for="DinGorevlisiIletisim" class="form-control" />
                            <span asp-validation-for="DinGorevlisiIletisim" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Ek Bilgiler -->
            <div class="col-md-12 mb-4">
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Ek Bilgiler</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="BaskonsoloslukBolgesi" class="form-label"></label>
                                <input asp-for="BaskonsoloslukBolgesi" class="form-control" />
                                <span asp-validation-for="BaskonsoloslukBolgesi" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Bolge" class="form-label"></label>
                                <input asp-for="Bolge" class="form-control" />
                                <span asp-validation-for="Bolge" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="KurulusKanunu" class="form-label"></label>
                                <input asp-for="KurulusKanunu" class="form-control" />
                                <span asp-validation-for="KurulusKanunu" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CrmUyelikFormDurumu" class="form-label"></label>
                                <select asp-for="CrmUyelikFormDurumu" class="form-select">
                                    <option value="">Seçiniz</option>
                                    <option value="Var">Var</option>
                                    <option value="Yok">Yok</option>
                                    <option value="Beklemede">Beklemede</option>
                                </select>
                                <span asp-validation-for="CrmUyelikFormDurumu" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="FrenchRegistrationName" class="form-label">Resmi Fransızca Adı (Prefecture Name)</label>
                                <input asp-for="FrenchRegistrationName" class="form-control" placeholder="örn. Association DITIB..." />
                                <span asp-validation-for="FrenchRegistrationName" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CemaatCount" class="form-label">Cemaat Sayısı</label>
                                <input asp-for="CemaatCount" class="form-control" type="number" min="0" placeholder="örn. 150" />
                                <span asp-validation-for="CemaatCount" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="form-check mt-4">
                                    <input asp-for="HasCami" class="form-check-input" type="checkbox" id="HasCami" />
                                    <label asp-for="HasCami" class="form-check-label fw-bold">Cami var mı?</label>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="form-check mt-4">
                                    <input asp-for="HasLojman" class="form-check-input" type="checkbox" id="HasLojman" />
                                    <label asp-for="HasLojman" class="form-check-label fw-bold">Lojman var mı?</label>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="LojmanKapasite" class="form-label">Lojman Kapasitesi (Kişi)</label>
                                <input asp-for="LojmanKapasite" class="form-control" type="number" min="0" placeholder="örn. 4" />
                                <span asp-validation-for="LojmanKapasite" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="form-check mt-4">
                                    <input asp-for="HasMustemilat" class="form-check-input" type="checkbox" id="HasMustemilat" />
                                    <label asp-for="HasMustemilat" class="form-check-label fw-bold">Müştemilat var mı?</label>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="MustemilatKapasite" class="form-label">Müştemilat Kapasitesi (Kişi)</label>
                                <input asp-for="MustemilatKapasite" class="form-control" type="number" min="0" placeholder="örn. 2" />
                                <span asp-validation-for="MustemilatKapasite" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Latitude" class="form-label">Enlem (Latitude)</label>
                                <input asp-for="Latitude" class="form-control" type="number" step="any" placeholder="örn. 48.5661" />
                                <span asp-validation-for="Latitude" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Longitude" class="form-label">Boylam (Longitude)</label>
                                <input asp-for="Longitude" class="form-control" type="number" step="any" placeholder="örn. 7.7786" />
                                <span asp-validation-for="Longitude" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Yönetim Kurulu Üyeleri -->
            <div class="col-md-12 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-users-cog me-2"></i>Yönetim Kurulu Üyeleri</h5>
                        <button type="button" id="btn-add-board-member" class="btn btn-sm btn-light text-dark fw-bold">
                            <i class="fas fa-plus me-1"></i>Yeni Üye Ekle
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped" id="board-members-table">
                                <thead class="table-light">
                                    <tr>
                                        <th>Ad Soyad</th>
                                        <th>İletişim Telefonu</th>
                                        <th>Yönetim Kurulu Rolü</th>
                                        <th style="width: 100px; text-align: center;">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody id="board-members-body">
                                    @if (Model != null && Model.YonetimKuruluUyeleri != null)
                                    {
                                        for (int i = 0; i < Model.YonetimKuruluUyeleri.Count; i++)
                                        {
                                            var member = Model.YonetimKuruluUyeleri.ElementAt(i);
                                            <tr>
                                                <td>
                                                    <input name="YonetimKuruluUyeleri[@i].FullName" class="form-control" required value="@member.FullName" placeholder="örn. Ahmet Yılmaz" />
                                                </td>
                                                <td>
                                                    <input name="YonetimKuruluUyeleri[@i].ContactPhone" class="form-control" value="@member.ContactPhone" placeholder="örn. +33 6..." />
                                                </td>
                                                <td>
                                                    <select name="YonetimKuruluUyeleri[@i].YonetimRolId" class="form-select" required>
                                                        @if (ViewBag.YonetimRolleri != null)
                                                        {
                                                            foreach (var role in ViewBag.YonetimRolleri)
                                                            {
                                                                <option value="@role.Id" selected="@(role.Id == member.YonetimRolId ? "selected" : null)">@role.Ad</option>
                                                            }
                                                        }
                                                    </select>
                                                </td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-danger btn-sm btn-remove-member"><i class="fas fa-trash"></i></button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div id="no-members-alert" class="alert alert-warning mb-0 text-center">
                            Henüz yönetim kurulu üyesi eklenmedi. "Yeni Üye Ekle" butonu ile ekleyebilirsiniz.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="duplicateWarningBanner" class="alert alert-warning d-none" role="alert">
            <strong>⚠️ DİKKAT:</strong> Girmekte olduğunuz bilgilere benzer kayıtlar sistemde mevcut. Eğer eminseniz işleme devam edebilirsiniz, sistem yöneticiye doğrulama bildirimi gönderecektir.
        </div>

        <div class="text-center mt-3">
            <button type="submit" class="btn btn-primary btn-lg px-5" id="btnSubmit">
                <i class="fas fa-save me-2"></i>Kaydet
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-lg">
                <i class="fas fa-times me-2"></i>İptal
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            // Initialize Select2 for city selection with tags support (allows new entries)
            $('.select2-city').select2({
                tags: true,
                placeholder: 'Seçiniz veya yeni şehir yazınız...',
                allowClear: true
            });

            var rolesJson = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.YonetimRolleri));
            var memberIndex = $('#board-members-body tr').length;

            function toggleNoMembersAlert() {
                if ($('#board-members-body tr').length === 0) {
                    $('#no-members-alert').show();
                } else {
                    $('#no-members-alert').hide();
                }
            }

            $('#btn-add-board-member').click(function() {
                var roleOptions = '';
                if (rolesJson && rolesJson.length > 0) {
                    $.each(rolesJson, function(i, role) {
                        roleOptions += '<option value="' + role.Id + '">' + role.Ad + '</option>';
                    });
                }

                var rowHtml = '<tr>' +
                    '<td><input name="YonetimKuruluUyeleri[' + memberIndex + '].FullName" class="form-control" required placeholder="örn. Ahmet Yılmaz" /></td>' +
                    '<td><input name="YonetimKuruluUyeleri[' + memberIndex + '].ContactPhone" class="form-control" placeholder="örn. +33 6..." /></td>' +
                    '<td><select name="YonetimKuruluUyeleri[' + memberIndex + '].YonetimRolId" class="form-select" required>' + roleOptions + '</select></td>' +
                    '<td class="text-center"><button type="button" class="btn btn-danger btn-sm btn-remove-member"><i class="fas fa-trash"></i></button></td>' +
                    '</tr>';

                $('#board-members-body').append(rowHtml);
                memberIndex++;
                toggleNoMembersAlert();
            });

            $(document).on('click', '.btn-remove-member', function() {
                $(this).closest('tr').remove();
                
                // Re-index rows
                $('#board-members-body tr').each(function(index, tr) {
                    $(tr).find('input, select').each(function(i, input) {
                        var name = $(input).attr('name');
                        if (name) {
                            var newName = name.replace(/\[\d+\]/, '[' + index + ']');
                            $(input).attr('name', newName);
                        }
                    });
                });
                memberIndex = $('#board-members-body tr').length;
                toggleNoMembersAlert();
            });

            toggleNoMembersAlert();

            $('#createForm').on('submit', function (e) {
                if ($(this).data('duplicate-checked')) return;
                e.preventDefault();

                var $btn = $('#btnSubmit');
                $btn.prop('disabled', true);
                $('#duplicateWarningBanner').addClass('d-none');

                var formData = {
                    Isim: $('#Isim').val(),
                    Adres: $('#Adres').val(),
                    SiretNo: $('#SiretNo').val(),
                    RnaNo: $('#RnaNo').val(),
                    IbanNo: $('#IbanNo').val()
                };

                $.ajax({
                    type: 'POST',
                    url: '/DernekIslemleri/CheckDuplicate',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function (res) {
                        if (res.isDuplicate) {
                            if (res.type === 'absolute') {
                                alert(res.message);
                                $btn.prop('disabled', false);
                            } else {
                                $('#duplicateWarningBanner').removeClass('d-none');
                                $btn.html('<i class="fas fa-save me-2"></i>Eminim, Kaydet');
                                $btn.prop('disabled', false);
                                $('#createForm').data('duplicate-checked', true);
                            }
                        } else {
                            $('#createForm').data('duplicate-checked', true).submit();
                        }
                    },
                    error: function () {
                        $('#createForm').data('duplicate-checked', true).submit();
                    }
                });
            });
        });
    </script>
}
