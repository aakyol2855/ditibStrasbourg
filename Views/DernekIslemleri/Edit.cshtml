@model DitibStasbourg.Models.Kurum

@{
    ViewData["Title"] = "Dernek Düzenle - " + Model.Isim;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">@Model.Isim - Düzenle</h2>
            <p class="text-muted mb-0 small">Dernek temel bilgilerini, yönetim kadrosunu ve koordinat ayarlarını güncelleyin.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Listeye Dön
        </a>
    </div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Tip" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <!-- Temel Bilgiler -->
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header bg-primary text-white d-flex align-items-center">
                        <h5 class="mb-0"><i class="bi bi-building me-2"></i>Temel Bilgiler</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Isim" class="form-label fw-bold small text-muted">Dernek Adı</label>
                            <input asp-for="Isim" class="form-control" required />
                            <span asp-validation-for="Isim" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Sehir" class="form-label fw-bold small text-muted">Şehir</label>
                            <select asp-for="Sehir" class="form-select select2-city">
                                <option value="">Seçiniz veya yeni yazınız...</option>
                                @if (ViewBag.Sehirler != null)
                                {
                                    foreach (var sehir in (List<string>)ViewBag.Sehirler)
                                    {
                                        <option value="@sehir" selected="@(Model.Sehir == sehir)">@sehir</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Sehir" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Adres" class="form-label fw-bold small text-muted">Adres</label>
                            <textarea asp-for="Adres" class="form-control" rows="3">@Model.Adres</textarea>
                            <span asp-validation-for="Adres" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UstKurumId" class="form-label fw-bold small text-muted">Bağlı Olduğu Kurum</label>
                            <select asp-for="UstKurumId" class="form-select">
                                <option value="">Bağımsız</option>
                                @if (ViewBag.UstKurumlar != null)
                                {
                                    foreach (var kurum in (List<DitibStasbourg.Models.Ref_KurumTuru>)ViewBag.UstKurumlar)
                                    {
                                        <option value="@kurum.Id" selected="@(Model.UstKurumId == kurum.Id)">@kurum.Ad</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="UstKurumId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IletisimNumarasi" class="form-label fw-bold small text-muted">Dernek İletişim Numarası</label>
                            <input asp-for="IletisimNumarasi" class="form-control" placeholder="+33..." />
                            <span asp-validation-for="IletisimNumarasi" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Maili" class="form-label fw-bold small text-muted">Dernek E-posta</label>
                            <input asp-for="Maili" class="form-control" type="email" placeholder="example@domain.com" />
                            <span asp-validation-for="Maili" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Yönetim Bilgileri -->
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header bg-info text-white d-flex align-items-center">
                        <h5 class="mb-0"><i class="bi bi-people me-2"></i>Yönetim Bilgileri</h5>
                    </div>
                    <div class="card-body">
                        <div class="bg-light p-3 rounded mb-4">
                            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-person-badge-fill me-1"></i>Dernek Başkanı</h6>
                            <div class="mb-2">
                                <label asp-for="DernekBaskaniAd" class="form-label small text-muted">Ad Soyad</label>
                                <input asp-for="DernekBaskaniAd" class="form-control" />
                                <span asp-validation-for="DernekBaskaniAd" class="text-danger"></span>
                            </div>
                            <div class="mb-2">
                                <label asp-for="DernekBaskaniIletisim" class="form-label small text-muted">İletişim</label>
                                <input asp-for="DernekBaskaniIletisim" class="form-control" />
                                <span asp-validation-for="DernekBaskaniIletisim" class="text-danger"></span>
                            </div>
                            <div class="mb-2">
                                <label asp-for="BaskanMail" class="form-label small text-muted">Başkan E-posta</label>
                                <input asp-for="BaskanMail" class="form-control" type="email" />
                                <span asp-validation-for="BaskanMail" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="bg-light p-3 rounded">
                            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-person-circle me-1"></i>Din Görevlisi</h6>
                            <div class="mb-2">
                                <label asp-for="DinGorevlisiAd" class="form-label small text-muted">Ad Soyad</label>
                                <input asp-for="DinGorevlisiAd" class="form-control" />
                                <span asp-validation-for="DinGorevlisiAd" class="text-danger"></span>
                            </div>
                            <div class="mb-2">
                                <label asp-for="DinGorevlisiIletisim" class="form-label small text-muted">İletişim</label>
                                <input asp-for="DinGorevlisiIletisim" class="form-control" />
                                <span asp-validation-for="DinGorevlisiIletisim" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ek Bilgiler -->
            <div class="col-md-12 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-secondary text-white d-flex align-items-center">
                        <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Ek ve Coğrafi Bilgiler</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="BaskonsoloslukBolgesi" class="form-label fw-bold small text-muted">Başkonsolosluk Bölgesi</label>
                                <input asp-for="BaskonsoloslukBolgesi" class="form-control" />
                                <span asp-validation-for="BaskonsoloslukBolgesi" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Bolge" class="form-label fw-bold small text-muted">Bölge</label>
                                <input asp-for="Bolge" class="form-control" />
                                <span asp-validation-for="Bolge" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="KurulusKanunu" class="form-label fw-bold small text-muted">Kuruluş Kanunu</label>
                                <input asp-for="KurulusKanunu" class="form-control" />
                                <span asp-validation-for="KurulusKanunu" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CrmUyelikFormDurumu" class="form-label fw-bold small text-muted">CRM Üyelik Form Durumu</label>
                                <select asp-for="CrmUyelikFormDurumu" class="form-select">
                                    <option value="">Seçiniz</option>
                                    <option value="Var">Var</option>
                                    <option value="Yok">Yok</option>
                                    <option value="Beklemede">Beklemede</option>
                                </select>
                                <span asp-validation-for="CrmUyelikFormDurumu" class="text-danger"></span>
                            </div>
                             <div class="col-md-4 mb-3">
                                 <label asp-for="FrenchRegistrationName" class="form-label fw-bold small text-muted">Resmi Fransızca Adı (Prefecture Name)</label>
                                 <input asp-for="FrenchRegistrationName" class="form-control" placeholder="örn. Association DITIB..." />
                                 <span asp-validation-for="FrenchRegistrationName" class="text-danger"></span>
                             </div>
                             <div class="col-md-4 mb-3">
                                 <label asp-for="CemaatCount" class="form-label fw-bold small text-muted">Cemaat Sayısı</label>
                                 <input asp-for="CemaatCount" class="form-control" type="number" min="0" placeholder="örn. 150" />
                                 <span asp-validation-for="CemaatCount" class="text-danger"></span>
                             </div>
                             <div class="col-md-4 mb-3">
                                 <label asp-for="Latitude" class="form-label fw-bold small text-muted">Enlem (Latitude)</label>
                                 <input asp-for="Latitude" class="form-control" type="number" step="any" placeholder="örn. 48.5661" />
                                 <span asp-validation-for="Latitude" class="text-danger"></span>
                             </div>
                             <div class="col-md-4 mb-3">
                                 <label asp-for="Longitude" class="form-label fw-bold small text-muted">Boylam (Longitude)</label>
                                 <input asp-for="Longitude" class="form-control" type="number" step="any" placeholder="örn. 7.7786" />
                                 <span asp-validation-for="Longitude" class="text-danger"></span>
                             </div>
                         </div>
                     </div>
                 </div>
             </div>

            <!-- Yönetim Kurulu Üyeleri -->
            <div class="col-md-12 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-people-fill me-2"></i>Yönetim Kurulu Üyeleri</h5>
                        <button type="button" id="btn-add-board-member" class="btn btn-sm btn-light fw-bold">
                            <i class="bi bi-plus me-1"></i>Yeni Üye Ekle
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped" id="board-members-table">
                                <thead class="table-light">
                                    <tr>
                                        <th>Ad Soyad</th>
                                        <th>İletişim Telefonu</th>
                                        <th>Yönetim Kurulu Rolü</th>
                                        <th style="width: 100px; text-align: center;">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody id="board-members-body">
                                    @if (Model.YonetimKuruluUyeleri != null)
                                    {
                                        var idx = 0;
                                        foreach (var member in Model.YonetimKuruluUyeleri.Where(m => !m.IsDeleted))
                                        {
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="YonetimKuruluUyeleri[@idx].Id" value="@member.Id" />
                                                    <input type="hidden" name="YonetimKuruluUyeleri[@idx].KurumId" value="@member.KurumId" />
                                                    <input name="YonetimKuruluUyeleri[@idx].FullName" class="form-control" value="@member.FullName" required placeholder="örn. Ahmet Yılmaz" />
                                                </td>
                                                <td>
                                                    <input name="YonetimKuruluUyeleri[@idx].ContactPhone" class="form-control" value="@member.ContactPhone" placeholder="örn. +33 6..." />
                                                </td>
                                                <td>
                                                    <select name="YonetimKuruluUyeleri[@idx].YonetimRolId" class="form-select" required>
                                                        @if (ViewBag.YonetimRolleri != null)
                                                        {
                                                            foreach (var role in (List<DitibStasbourg.Models.Ref_YonetimRol>)ViewBag.YonetimRolleri)
                                                            {
                                                                <option value="@role.Id" selected="@(member.YonetimRolId == role.Id)">@role.Ad</option>
                                                            }
                                                        }
                                                    </select>
                                                </td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-danger btn-sm btn-remove-member"><i class="bi bi-trash"></i></button>
                                                </td>
                                            </tr>
                                            idx++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div id="no-members-alert" class="alert alert-warning mb-0 text-center">
                            Henüz yönetim kurulu üyesi eklenmedi. "Yeni Üye Ekle" butonu ile ekleyebilirsiniz.
                        </div>
                    </div>
                </div>
            </div>
         </div>
 
         <div class="text-center mt-3">
             <button type="submit" class="btn btn-primary btn-lg px-5">
                 <i class="bi bi-save me-2"></i>Güncelle
             </button>
             <a asp-action="Index" class="btn btn-secondary btn-lg">
                 <i class="bi bi-x me-2"></i>İptal
             </a>
         </div>
     </form>
 </div>
 
 @section Scripts {
     @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
     
     <script>
         $(document).ready(function() {
             $('.select2-city').select2({
                 tags: true,
                 placeholder: 'Seçiniz veya yeni şehir yazınız...',
                 allowClear: true
             });

             var rolesJson = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.YonetimRolleri));
             var memberIndex = $('#board-members-body tr').length;

             function toggleNoMembersAlert() {
                 if ($('#board-members-body tr').length === 0) {
                     $('#no-members-alert').show();
                 } else {
                     $('#no-members-alert').hide();
                 }
             }

             $('#btn-add-board-member').click(function() {
                 var roleOptions = '';
                 if (rolesJson && rolesJson.length > 0) {
                     $.each(rolesJson, function(i, role) {
                         roleOptions += '<option value="' + role.Id + '">' + role.Ad + '</option>';
                     });
                 }

                 var rowHtml = '<tr>' +
                     '<td>' +
                     '<input type="hidden" name="YonetimKuruluUyeleri[' + memberIndex + '].Id" value="0" />' +
                     '<input name="YonetimKuruluUyeleri[' + memberIndex + '].FullName" class="form-control" required placeholder="örn. Ahmet Yılmaz" />' +
                     '</td>' +
                     '<td><input name="YonetimKuruluUyeleri[' + memberIndex + '].ContactPhone" class="form-control" placeholder="örn. +33 6..." /></td>' +
                     '<td><select name="YonetimKuruluUyeleri[' + memberIndex + '].YonetimRolId" class="form-select" required>' + roleOptions + '</select></td>' +
                     '<td class="text-center"><button type="button" class="btn btn-danger btn-sm btn-remove-member"><i class="bi bi-trash"></i></button></td>' +
                     '</tr>';

                 $('#board-members-body').append(rowHtml);
                 memberIndex++;
                 toggleNoMembersAlert();
             });

             $(document).on('click', '.btn-remove-member', function() {
                 $(this).closest('tr').remove();
                 
                 // Re-index rows
                 $('#board-members-body tr').each(function(index, tr) {
                     $(tr).find('input, select').each(function(i, input) {
                         var name = $(input).attr('name');
                         if (name) {
                             var newName = name.replace(/\[\d+\]/, '[' + index + ']');
                             $(input).attr('name', newName);
                         }
                     });
                 });
                 memberIndex = $('#board-members-body tr').length;
                 toggleNoMembersAlert();
             });

             toggleNoMembersAlert();
         });
     </script>
 }
