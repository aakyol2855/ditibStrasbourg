@model DitibStasbourg.Models.Gorevlendirme

@{
    ViewData["Title"] = "Sil";
}

<h1>Sil</h1>

<h3>Bunu silmek istediğinizden emin misiniz?</h3>
<div>
    <h4>Görevlendirme</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tarih)
        </dt>
        <dd class = "col-sm-10">
            @Model.Tarih.ToShortDateString()
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BitisTarihi)
        </dt>
        <dd class = "col-sm-10">
            @(Model.BitisTarihi.HasValue ? Model.BitisTarihi.Value.ToShortDateString() : "-")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Gorevli)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Gorevli.AdSoyad)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Kurum)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Kurum.Isim)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Sil" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
    </form>
</div>
