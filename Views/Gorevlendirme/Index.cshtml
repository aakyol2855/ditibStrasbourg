@using DitibStasbourg.Models
@model PaginatedList<DitibStasbourg.Models.Gorevlendirme>

@{
    ViewData["Title"] = "Görevlendirmeler";
    var years = ViewBag.Years as List<int> ?? new List<int>();
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<h1 class="mb-4">Görevlendirmeler</h1>

<!-- Main Filter Card -->
<div class="card mb-3 shadow-sm border-0">
    <div class="card-header bg-light fw-bold"><i class="fas fa-filter"></i> Filtrele</div>
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-2">
                <label class="form-label small text-muted">Yıl</label>
                <select name="year" class="form-select form-select-sm">
                    <option value="">Tümü</option>
                    @foreach (var y in years)
                    {
                        if (ViewData["CurrentYear"] != null && (int)ViewData["CurrentYear"] == y)
                        { <option value="@y" selected>@y</option> }
                        else
                        { <option value="@y">@y</option> }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Kurum Tipi</label>
                <select name="tip" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<DitibStasbourg.Models.KurumTip>()">
                    <option value="">Tümü</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Kurum</label>
                <select name="kurumId" class="form-select form-select-sm" asp-items="ViewBag.KurumId">
                    <option value="">Tümü</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Görevli</label>
                <select name="gorevliId" class="form-select form-select-sm" asp-items="ViewBag.GorevliId">
                    <option value="">Tümü</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Tarih Aralığı (Başlangıç)</label>
                <input type="date" name="startDate" class="form-control form-control-sm" value="@ViewData["CurrentStartDate"]" />
            </div>
             <div class="col-md-2">
                <label class="form-label small text-muted">Tarih Aralığı (Bitiş)</label>
                <input type="date" name="endDate" class="form-control form-control-sm" value="@ViewData["CurrentEndDate"]" />
            </div>
            
            <div class="col-md-12 text-end mt-3">
                <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search"></i> Filtrele</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Temizle</a>
            </div>
        </form>
    </div>
</div>

<!-- Excel Export Accordion -->
<div class="accordion mb-4" id="accordionExcel">
    <div class="accordion-item shadow-sm border-0">
        <h2 class="accordion-header" id="headingExcel">
            <button class="accordion-button collapsed bg-success text-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExcel" aria-expanded="false" aria-controls="collapseExcel">
                <i class="fas fa-file-excel me-2"></i> Özel Excel Raporu Oluştur (Tıkla ve Seç)
            </button>
        </h2>
        <div id="collapseExcel" class="accordion-collapse collapse" aria-labelledby="headingExcel" data-bs-parent="#accordionExcel">
            <div class="accordion-body bg-white">
                <form asp-action="ExportToExcel" method="post">
                    <!-- Hidden filters to pass current view state -->
                    <input type="hidden" name="year" value="@ViewData["CurrentYear"]" />
                    <input type="hidden" name="tip" value="@ViewData["CurrentTip"]" />
                    <input type="hidden" name="gorevliId" value="@ViewData["CurrentGorevliId"]" />
                    <input type="hidden" name="kurumId" value="@ViewData["CurrentKurumId"]" />
                    <input type="hidden" name="startDate" value="@ViewData["CurrentStartDate"]" />
                    <input type="hidden" name="endDate" value="@ViewData["CurrentEndDate"]" />

                    <h6 class="fw-bold mb-3">Dahil Edilecek Sütunlar:</h6>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="columns" value="BaslangicTarihi" id="colStartDate" checked>
                                <label class="form-check-label" for="colStartDate">Başlangıç Tarihi</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="columns" value="BitisTarihi" id="colEndDate" checked>
                                <label class="form-check-label" for="colEndDate">Bitiş Tarihi</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="columns" value="Gorevli" id="colGorevli" checked>
                                <label class="form-check-label" for="colGorevli">Görevli Adı</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="columns" value="GorevliEmail" id="colEmail" checked>
                                <label class="form-check-label" for="colEmail">Görevli E-posta</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="columns" value="Kurum" id="colKurum" checked>
                                <label class="form-check-label" for="colKurum">Kurum Adı</label>
                            </div>
                        </div>
                         <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="columns" value="KurumTipi" id="colTip" checked>
                                <label class="form-check-label" for="colTip">Kurum Tipi</label>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-success"><i class="fas fa-download"></i> Raporu İndir</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Yeni Ekle</a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParm"]" class="text-decoration-none text-dark">
                    @Html.DisplayNameFor(model => model.FirstOrDefault().Tarih) <i class="fas fa-sort"></i>
                </a>
            </th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Gorevli)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Kurum)</th>
            <th>Kurum Tipi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Tarih.ToShortDateString()</td>
            <td>@Html.DisplayFor(modelItem => item.Gorevli.AdSoyad)</td>
            <td>@Html.DisplayFor(modelItem => item.Kurum.Isim)</td>
            <td>
                @if (item.Kurum.Tip == DitibStasbourg.Models.KurumTip.Cami) { <span class="badge bg-info text-dark">Adres</span> }
                else { <span class="badge bg-secondary">Dernek</span> }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detay</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
            </td>
        </tr>
}
    </tbody>
</table>

<div class="d-flex justify-content-between mt-4">
    <a asp-action="Index"
       asp-route-sortOrder="@ViewData["CurrentSort"]"
       asp-route-pageNumber="@(Model.PageIndex - 1)"
       class="btn btn-outline-secondary @prevDisabled">
        &laquo; Önceki
    </a>
    <span>Sayfa @Model.PageIndex / @Model.TotalPages</span>
    <a asp-action="Index"
       asp-route-sortOrder="@ViewData["CurrentSort"]"
       asp-route-pageNumber="@(Model.PageIndex + 1)"
       class="btn btn-outline-secondary @nextDisabled">
        Sonraki &raquo;
    </a>
</div>
