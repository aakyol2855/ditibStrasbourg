@model IEnumerable<DitibStasbourg.Models.Ref_SozlesmeTip>

@{
    ViewData["Title"] = "Sözleşme Tipleri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Sözleşme Tipleri</h1>
    <a asp-action="SozlesmeTipCreate" class="btn btn-success"><i class="fas fa-plus"></i> Yeni Ekle</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Ad</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Ad</td>
            <td>
                <a asp-action="SozlesmeTipEdit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                <a asp-action="SozlesmeTipDelete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
            </td>
        </tr>
}
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Tanımlamalara Dön</a>
</div>
