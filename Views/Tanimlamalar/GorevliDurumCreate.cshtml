@model DitibStasbourg.Models.Ref_GorevliDurum

@{
    ViewData["Title"] = "Yeni Durum Ekle";
}

<h1>Yeni Durum Ekle</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="GorevliDurumCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Ad" class="control-label"></label>
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Renk" class="control-label">Renk (Hex Kod veya İsim)</label>
                <input asp-for="Renk" class="form-control" type="color" />
                <span asp-validation-for="Renk" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Sira" class="control-label"></label>
                <input asp-for="Sira" class="form-control" />
                <span asp-validation-for="Sira" class="text-danger"></span>
            </div>
            <div class="form-group form-check mb-3">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="AktifMi" /> @Html.DisplayNameFor(model => model.AktifMi)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Ekle" class="btn btn-primary" />
                <a asp-action="GorevliDurumList" class="btn btn-secondary">Listeye Dön</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
