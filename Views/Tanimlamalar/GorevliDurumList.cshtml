@model IEnumerable<DitibStasbourg.Models.Ref_GorevliDurum>

@{
    ViewData["Title"] = "Görevli Durumları";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Görevli Durumları</h1>
    <a asp-action="GorevliDurumCreate" class="btn btn-success"><i class="fas fa-plus"></i> Yeni Ekle</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Sıra</th>
            <th>Ad</th>
            <th>Renk</th>
            <th>Aktif</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Sira</td>
            <td>@item.Ad</td>
            <td>
                <span class="badge" style="background-color: @(item.Renk ?? "gray"); color: white;">@item.Renk</span>
            </td>
            <td>
                 @if(item.AktifMi) { <span class="badge bg-success">Evet</span> } else { <span class="badge bg-danger">Hayır</span> }
            </td>
            <td>
                <a asp-action="GorevliDurumEdit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                <a asp-action="GorevliDurumDelete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
            </td>
        </tr>
}
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Tanımlamalara Dön</a>
</div>
