@model DitibStasbourg.Models.Ref_SozlesmeTip

@{
    ViewData["Title"] = "Yeni Sözleşme Tipi Ekle";
}

<h1>Yeni Sözleşme Tipi Ekle</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="SozlesmeTipCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Ad" class="control-label"></label>
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" class="text-danger"></span>
            </div>
            <div class="form-group form-check mb-3">
                <input asp-for="IsLocalContract" class="form-check-input" type="checkbox" />
                <label asp-for="IsLocalContract" class="form-check-label"></label>
                <span asp-validation-for="IsLocalContract" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Ekle" class="btn btn-primary" />
                <a asp-action="SozlesmeTipList" class="btn btn-secondary">Listeye Dön</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
