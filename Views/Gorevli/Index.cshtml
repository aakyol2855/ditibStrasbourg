@using DitibStasbourg.Models
@model PaginatedList<DitibStasbourg.Models.Gorevli>

@{
    ViewData["Title"] = "Görevliler";
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<style type="text/css">
    .contextual-action-bar-container {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translate(-50%, 120px);
        z-index: 1050;
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(12px) saturate(1.5);
        -webkit-backdrop-filter: blur(12px) saturate(1.5);
        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
        border-radius: 50px;
        padding: 10px 24px;
        opacity: 0;
        visibility: hidden;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s, visibility 0.3s;
    }
    .contextual-action-bar-container.show {
        transform: translate(-50%, 0);
        opacity: 1;
        visibility: visible;
    }
    .h-divider {
        width: 1px;
        height: 24px;
        background: rgba(255, 255, 255, 0.15);
    }
    
    /* Dark slate glassmorphism panel */
    .glass-panel {
        background: rgba(15, 23, 42, 0.96) !important;
        backdrop-filter: blur(20px) saturate(1.7) !important;
        -webkit-backdrop-filter: blur(20px) saturate(1.7) !important;
        border: 1px solid rgba(255, 255, 255, 0.14) !important;
        border-radius: 1.25rem !important;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45) !important;
        color: #fff !important;
        padding: 1.6rem 2.2rem !important;
    }
    .glass-panel h5 {
        color: #fff !important;
    }
    .glass-panel .form-label {
        color: rgba(255, 255, 255, 0.8) !important;
        font-size: 0.76rem;
        font-weight: 600;
        letter-spacing: 0.02em;
    }
    .glass-panel .form-control, 
    .glass-panel .form-select {
        background-color: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        color: #fff !important;
        border-radius: 0.5rem !important;
    }
    .glass-panel .form-control::placeholder {
        color: rgba(255, 255, 255, 0.4) !important;
    }
    .glass-panel .form-control:focus, 
    .glass-panel .form-select:focus {
        background-color: rgba(255, 255, 255, 0.12) !important;
        border-color: #3b82f6 !important;
        color: #fff !important;
        box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25) !important;
    }
    .glass-panel .form-select option {
        background-color: #0f172a !important;
        color: #fff !important;
    }
    
    /* Select2 Dark Mode Override */
    .glass-panel .select2-container--default .select2-selection--multiple {
        background-color: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        border-radius: 0.5rem !important;
        min-height: 38px;
    }
    .glass-panel .select2-container--default .select2-selection--multiple .select2-selection__choice {
        background-color: rgba(255, 255, 255, 0.15) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        color: #fff !important;
        border-radius: 0.25rem !important;
        padding: 1px 8px !important;
        font-size: 0.8rem;
    }
    .glass-panel .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
        color: rgba(255, 255, 255, 0.7) !important;
        margin-right: 5px !important;
    }
    .glass-panel .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover {
        color: #ef4444 !important;
    }
    .glass-panel .select2-container--default.select2-container--focus .select2-selection--multiple {
        border-color: #3b82f6 !important;
    }
    .select2-dropdown {
        background-color: #0f172a !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        color: #fff !important;
        z-index: 99999 !important;
    }
    .select2-container--default .select2-search--inline .select2-search__field {
        color: #fff !important;
    }
    .select2-container--default .select2-results__option--highlighted[aria-selected] {
        background-color: #2563eb !important;
    }
    .select2-container--default .select2-results__option[aria-selected=true] {
        background-color: rgba(255, 255, 255, 0.12) !important;
    }

    /* Collapsible export section styles */
    .ep-trigger {
        cursor: pointer;
        user-select: none;
        padding: 1.1rem 0;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        margin-top: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .ep-trigger h6 {
        margin: 0;
        font-weight: 700;
        font-size: 0.82rem;
        letter-spacing: 0.06em;
        color: rgba(255, 255, 255, 0.95);
        text-transform: uppercase;
    }
    .ep-trigger .ep-chevron-icon {
        color: rgba(255, 255, 255, 0.6);
        transition: transform 0.25s ease;
    }
    .ep-content {
        display: none;
        padding-top: 0.5rem;
    }
    .ep-content.show {
        display: block;
    }
    .ep-col-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 0.5rem 1rem;
        max-height: 200px;
        overflow-y: auto;
        padding-right: 0.5rem;
        margin-bottom: 1.2rem;
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
    }
    .ep-col-grid::-webkit-scrollbar {
        width: 4px;
    }
    .ep-col-grid::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 2px;
    }
    .ep-checkbox-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.6rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 0.4rem;
        border: 1px solid rgba(255, 255, 255, 0.07);
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .ep-checkbox-item:hover, .ep-checkbox-item.active {
        background: rgba(59, 130, 246, 0.2);
        border-color: rgba(59, 130, 246, 0.4);
    }
    .ep-checkbox-item input {
        accent-color: #3b82f6;
        cursor: pointer;
        width: 14px;
        height: 14px;
    }
    .ep-checkbox-item label {
        font-size: 0.74rem;
        color: rgba(255, 255, 255, 0.8);
        cursor: pointer;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .border-white-10 {
        border-color: rgba(255, 255, 255, 0.1) !important;
    }
</style>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-0">Görevliler <help-icon topic-id="1" title="Personel Yönetimi"></help-icon></h1>
            <p class="text-muted mb-0 small">Diyanet ve yerel sözleşmeli personelin görev geçmişi, notları ve aktiflik durumları.</p>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("SuperAdmin"))
            {
                <a asp-action="Import" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-2"></i>Excel'den Yükle</a>
            }
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Yeni Görevli Ekle</a>
        </div>
    </div>

    @{
        var filter = ViewData["Filter"] as DitibStasbourg.Models.ViewModels.GorevliFilterViewModel ?? new DitibStasbourg.Models.ViewModels.GorevliFilterViewModel();
    }

    <!-- Collapsible Filter Accordion -->
    <div class="accordion mb-4" id="gorevliFilterAccordion">
        <div class="accordion-item border-0 rounded-4 overflow-hidden">
            <h2 class="accordion-header" id="filterPanelHeading">
                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#filterPanelCollapse" aria-expanded="false" aria-controls="filterPanelCollapse" style="background: rgba(15, 23, 42, 0.96); color: #fff; border-radius: 1.25rem;">
                    <i class="bi bi-funnel-fill text-primary me-2"></i>
                    Gelişmiş Arama, Filtreleme ve Raporlama
                </button>
            </h2>
            <div id="filterPanelCollapse" class="accordion-collapse collapse" aria-labelledby="filterPanelHeading" data-bs-parent="#gorevliFilterAccordion">
                <div class="glass-panel shadow" style="border-top-left-radius: 0 !important; border-top-right-radius: 0 !important;">
    <form asp-action="Index" method="get" id="filterForm">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Görevli Arama (İsim, Soyad, E-posta)</label>
                    <select name="StaffIds" id="staffSearch" class="form-select" multiple="multiple">
                        <!-- Options loaded via AJAX -->
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Kurum</label>
                    <select name="KurumId" class="form-select" asp-items="@(new SelectList(ViewBag.Kurumlar, "Id", "Isim", filter.KurumId))">
                        <option value="">Tümü</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Şehir</label>
                    <select name="Sehir" class="form-select" asp-items="@(new SelectList(ViewBag.Sehirler, filter.Sehir))">
                        <option value="">Tümü</option>
                    </select>
                </div>
                
                <div class="col-md-3">
                    <label class="form-label">Sözleşme Tipi</label>
                    <select name="SozlesmeTipId" class="form-select" asp-items="@(new SelectList(ViewBag.SozlesmeTipleri, "Id", "Ad", filter.SozlesmeTipId))">
                        <option value="">Tümü</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Cinsiyet</label>
                    <select name="Cinsiyet" class="form-select">
                        <option value="">Tümü</option>
                        <option value="E" selected="@(filter.Cinsiyet == "E")">Erkek</option>
                        <option value="K" selected="@(filter.Cinsiyet == "K")">Kadın</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Aktiflik</label>
                    <select name="IsActive" class="form-select">
                        <option value="">Hepsi</option>
                        <option value="true" selected="@(filter.IsActive == true)">Aktif Görevde</option>
                        <option value="false" selected="@(filter.IsActive == false)">Pasif / Görevde Değil</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Ünvan</label>
                    <select name="UnvanIds" class="form-select" multiple asp-items="@(new SelectList(ViewBag.Unvanlar, "Id", "Ad", filter.UnvanIds))">
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Eğitim Durumu</label>
                    <select name="EgitimDurumuIds" class="form-select" multiple asp-items="@(new SelectList(ViewBag.EgitimDurumlari, "Id", "Ad", filter.EgitimDurumuIds))">
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hafızlık</label>
                    <select name="HafizlikDurumuIds" class="form-select" multiple asp-items="@(new SelectList(ViewBag.HafizlikDurumlari, "Id", "Ad", filter.HafizlikDurumuIds))">
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Kadro Türü</label>
                    <select name="KadroTuruIds" class="form-select" multiple asp-items="@(new SelectList(ViewBag.KadroTurleri, "Id", "Ad", filter.KadroTuruIds))">
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Kan Grubu</label>
                    <select name="KanGrubuIds" class="form-select" multiple asp-items="@(new SelectList(ViewBag.KanGruplari, "Id", "Ad", filter.KanGrubuIds))">
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Askerlik Durumu</label>
                    <select name="AskerlikDurumuIds" class="form-select" multiple asp-items="@(new SelectList(ViewBag.AskerlikDurumlari, "Id", "Ad", filter.AskerlikDurumuIds))">
                    </select>
                </div>

                <div class="col-md-9">
                    <label class="form-label d-block">Görevli Durumu</label>
                    <div class="d-flex flex-wrap gap-2 mt-1">
                        @if (ViewBag.Durumlar != null)
                        {
                            foreach (var durum in (List<DitibStasbourg.Models.Ref_GorevliDurum>)ViewBag.Durumlar)
                            {
                                var isChecked = filter.GorevliDurumIds != null && filter.GorevliDurumIds.Contains(durum.Id);
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="GorevliDurumIds" value="@durum.Id" id="status_@durum.Id" @(isChecked ? "checked" : "")>
                                    <label class="form-check-label badge rounded-pill px-3 py-1" style="background-color: @(durum.Renk ?? "gray"); color: white; cursor: pointer;" for="status_@durum.Id">
                                        @durum.Ad
                                    </label>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- NEW: Leave, FransaGiris & SözlesmeBaslangıç Filters -->
            <div class="row g-3 mt-1">
                <div class="col-md-3">
                    <label class="form-label text-white">Fransa Giriş — Başlangıç</label>
                    <input type="date" name="FransaGirisBaslangic" class="form-control form-control-sm"
                           value="@(filter.FransaGirisBaslangic?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-white">Fransa Giriş — Bitiş</label>
                    <input type="date" name="FransaGirisBitis" class="form-control form-control-sm"
                           value="@(filter.FransaGirisBitis?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-white">Sözleşme Başlangıcı (Min)</label>
                    <input type="date" name="SozlesmeBaslangicMin" class="form-control form-control-sm"
                           value="@(filter.SozlesmeBaslangicMin?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-white">Sözleşme Başlangıcı (Max)</label>
                    <input type="date" name="SozlesmeBaslangicMax" class="form-control form-control-sm"
                           value="@(filter.SozlesmeBaslangicMax?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-white">İzin Durumu</label>
                    <select name="HasLeave" class="form-select form-select-sm">
                        <option value="">Tümü</option>
                        @if (filter.HasLeave == true)
                        {
                            <option value="true" selected>Onaylı İzni Var</option>
                            <option value="false">Onaylı İzni Yok</option>
                        }
                        else if (filter.HasLeave == false)
                        {
                            <option value="true">Onaylı İzni Var</option>
                            <option value="false" selected>Onaylı İzni Yok</option>
                        }
                        else
                        {
                            <option value="true">Onaylı İzni Var</option>
                            <option value="false">Onaylı İzni Yok</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Column Selection Section (Collapsible) -->
            <div class="ep-trigger" onclick="toggleExportSection()">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-spreadsheet-fill text-success" style="font-size: 1.1rem;"></i>
                    <h6>📊 Gelişmiş Raporlama &amp; Excel Dışa Aktarım Sütunları</h6>
                </div>
                <span class="ep-chevron-icon"><i class="bi bi-chevron-down"></i></span>
            </div>

            <div class="ep-content" id="exportSectionContent">
                <p style="font-size: 0.72rem; color: rgba(255, 255, 255, 0.55); margin-bottom: 0.75rem;">
                    Dışa aktarılacak sütunları seçin veya standart/hızlı dışa aktarımı kullanın.
                </p>

                <div class="ep-col-grid" id="ep-col-grid">
                    <div class="text-white-50 small p-2">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        Sütun şeması yükleniyor...
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 mb-2">
                    <button type="button" class="btn btn-sm btn-outline-light" onclick="toggleAllColumns()">
                        <i class="bi bi-check2-all me-1"></i> Tümünü Seç / Temizle
                    </button>
                    <span class="small text-muted ms-2" id="ep-selected-cols-count">0 sütun seçili</span>
                    
                    <div class="ms-auto text-warning small" id="ep-selected-rows-badge" style="display: none;">
                        <i class="bi bi-filter-circle-fill me-1"></i>
                        <span id="ep-selected-rows-count">0</span> satır seçili (yalnızca bu satırlar aktarılacak)
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="col-md-12 text-end border-top border-white-10 pt-3 mt-4">
                <a asp-action="Index" class="btn btn-outline-light me-2"><i class="bi bi-arrow-counterclockwise me-1"></i> Filtreleri Temizle</a>
                <button type="submit" class="btn btn-primary me-2"><i class="bi bi-funnel-fill me-1"></i> Sorgula &amp; Listele</button>
                
                <button type="button" class="btn btn-success me-2" onclick="submitQuickExport()">
                    <i class="bi bi-lightning-fill me-1"></i> Hızlı Excel Dışa Aktar
                </button>
                <button type="button" class="btn btn-info" onclick="submitCustomExport()">
                    <i class="bi bi-file-earmark-excel-fill me-1"></i> Seçili Sütunları İndir
                </button>
            </div>
        </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Grid Header -->
    <div class="row mb-2 fw-bold text-muted border-bottom pb-2 d-none d-md-flex align-items-center">
        <div class="col-md-1 text-center" style="width: 50px;">
            <input type="checkbox" id="selectAllGorevli" class="form-check-input" style="cursor: pointer;" />
        </div>
        <div class="col-md-3">
            <a href="javascript:void(0)" onclick="changeSortOrder('@ViewData["NameSortParm"]')" class="text-decoration-none text-dark">Ad Soyad <i class="fas fa-sort"></i></a>
        </div>
        <div class="col-md-2">
            <a href="javascript:void(0)" onclick="changeSortOrder('@ViewData["StatusSortParm"]')" class="text-decoration-none text-dark">Referans Durumu <i class="fas fa-sort"></i></a>
        </div>
        <div class="col-md-2">Son Görev</div>
        <div class="col-md-2">
            <a href="javascript:void(0)" onclick="changeSortOrder('@ViewData["DateSortParm"]')" class="text-decoration-none text-dark">Tarihler <i class="fas fa-sort"></i></a>
        </div>
        <div class="col-md-1 text-center">
            <a href="javascript:void(0)" onclick="changeSortOrder('@ViewData["ActiveSortParm"]')" class="text-decoration-none text-dark">Aktif mi? <i class="fas fa-sort"></i></a>
        </div>
        <div class="col-md-1 text-end" style="flex-grow: 1;">İşlemler</div>
    </div>

    <div class="accordion" id="accordionGorevli">
        @foreach (var item in Model) {
            var lastAssignment = item.Gorevlendirmeler.OrderByDescending(g => g.Tarih).FirstOrDefault();
            var lastPlace = lastAssignment?.Kurum?.Isim ?? "-";
            
            var earliestStart = item.Gorevlendirmeler.OrderBy(g => g.Tarih).FirstOrDefault()?.Tarih;
            var latestEnd = item.Gorevlendirmeler.OrderByDescending(g => g.BitisTarihi).FirstOrDefault()?.BitisTarihi;
            
            <div class="accordion-item mb-2 shadow-sm border-0" style="border-left: 5px solid @(item.GorevliDurumBilgisi?.Renk ?? "#6c757d") !important; border-radius: 0.5rem; overflow: hidden;">
                <h2 class="accordion-header" id="heading-@item.Id">
                    <div class="d-flex align-items-center bg-white">
                        <div class="px-3 text-center" style="width: 50px; flex-shrink: 0;">
                            <input type="checkbox" class="form-check-input core-checkbox gorevli-select" value="@item.Id" data-id="@item.Id" />
                        </div>
                        <button class="accordion-button collapsed py-3 flex-grow-1" style="background: transparent !important; box-shadow: none;" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.Id" aria-expanded="false" aria-controls="collapse-@item.Id">
                            <div class="container-fluid p-0">
                                <div class="row align-items-center">
                                    <div class="col-md-3 fw-bold">@item.AdSoyad <br/>
                                        <small class="text-muted">@(item.Cinsiyet == "E" ? "Erkek" : item.Cinsiyet == "K" ? "Kadın" : "")</small>
                                        <br />
                                        @if (item.Unvan != null)
                                        {
                                            <span class="badge bg-light text-dark border">@item.Unvan.Ad</span>
                                        }
                                        @if (item.GorevliNotlari != null && item.GorevliNotlari.Any())
                                        {
                                            <i class="fas fa-sticky-note text-warning ms-2" title="Not Mevcut"></i>
                                        }
                                    </div>
                                    <div class="col-md-2">
                                        @if (item.GorevliDurumBilgisi != null)
                                        {
                                            <span class="badge" style="background-color: @(item.GorevliDurumBilgisi.Renk ?? "#6c757d"); color: white;">@item.GorevliDurumBilgisi.Ad</span>
                                        }
                                        else
                                        {
                                            var activeAssg = item.Gorevlendirmeler.FirstOrDefault(g => !g.IsDeleted && DateTime.Now.Date >= g.Tarih.Date && (!g.BitisTarihi.HasValue || DateTime.Now.Date <= g.BitisTarihi.Value.Date));
                                            if (activeAssg != null)
                                            {
                                                <span class="badge bg-success">Aktif Görevde</span>
                                            }
                                            else if (item.Gorevlendirmeler.Any(g => !g.IsDeleted))
                                            {
                                                <span class="badge bg-warning text-dark">Pasif (Süresi Bitti)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Atama Bekliyor</span>
                                            }
                                        }
                                        @if (item.SozlesmeTip != null)
                                        {
                                            <br/><span class="badge bg-info text-dark mt-1">@item.SozlesmeTip.Ad</span>
                                        }
                                    </div>
                                    <div class="col-md-2 small text-muted">@lastPlace</div>
                                    <div class="col-md-2 small text-muted">
                                        @if(earliestStart.HasValue) {
                                            <div><small>Baş:</small> @earliestStart.Value.ToString("dd.MM.yyyy")</div>
                                        } else {
                                            <div><small>Baş:</small> -</div>
                                        }
                                        @if(latestEnd.HasValue) {
                                            <div><small>Bit:</small> @latestEnd.Value.ToString("dd.MM.yyyy")</div>
                                        }
                                    </div>
                                    <div class="col-md-1 text-center">
                                        @if (item.isActive) {
                                            <span class="text-success" title="Şu an görevde"><i class="fas fa-check-circle fa-lg"></i></span>
                                        } else {
                                            <span class="text-danger" title="Görevde değil"><i class="fas fa-times-circle fa-lg"></i></span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </button>
                    </div>
                </h2>
                <div id="collapse-@item.Id" class="accordion-collapse collapse" aria-labelledby="heading-@item.Id" data-bs-parent="#accordionGorevli">
                    <div class="accordion-body bg-white border-top">
                        <div class="d-flex justify-content-end mb-3">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning" title="Düzenle"><i class="bi bi-pencil-square"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info text-white" title="Detay"><i class="bi bi-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Sil"><i class="bi bi-trash"></i></a>
                            </div>
                        </div>
                        
                        <h5 class="border-bottom pb-2">Görev Geçmişi</h5>
                        @if (item.Gorevlendirmeler.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered text-dark">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Kurum</th>
                                            <th>Tarih</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach(var gorev in item.Gorevlendirmeler.OrderByDescending(g => g.Tarih))
                                        {
                                            <tr>
                                                <td>@gorev.Kurum?.Isim</td>
                                                <td>@gorev.Tarih.ToString("dd.MM.yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted fst-italic">Henüz görevlendirme yok.</p>
                        }
                        
                        <h5 class="border-bottom pb-2 mt-4">Notlar</h5>
                        @if (item.GorevliNotlari != null && item.GorevliNotlari.Any())
                        {
                            <div class="mb-3">
                                @foreach(var not in item.GorevliNotlari.OrderByDescending(n => n.Tarih))
                                {
                                    <div class="alert alert-light border-start border-warning border-3 mb-2">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1 text-dark">
                                                <p class="mb-1">@not.NotIcerik</p>
                                                <small class="text-muted">
                                                    <i class="fas fa-calendar me-1"></i>@not.Tarih.ToString("dd MMM yyyy HH:mm")
                                                </small>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteNote(@not.Id, @item.Id)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted fst-italic small">Henüz not eklenmemiş.</p>
                        }
                        
                        <form id="note-form-@item.Id" onsubmit="event.preventDefault(); addNote(@item.Id);" class="mb-3">
                            @Html.AntiForgeryToken()
                            <div class="input-group">
                                <textarea id="note-input-@item.Id" name="notIcerik" class="form-control" rows="2" placeholder="Yeni not ekle..." required></textarea>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-plus"></i> Ekle
                                </button>
                            </div>
                        </form>
                        
                        <div class="mt-3 text-dark">
                            <strong>E-posta:</strong> <a href="mailto:@item.Email">@item.Email</a> <br/>
                            <strong>Toplam Görev Sayısı:</strong> @item.Gorevlendirmeler.Count
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination & Page Size Control -->
    <div class="d-flex justify-content-between mt-4 align-items-center">
        <div class="d-flex align-items-center">
            <label class="me-2 text-muted small mb-0 text-nowrap">Her Sayfada:</label>
            <select name="PageSize" class="form-select form-select-sm w-auto me-4" onchange="changePageSize(this.value)">
                <option value="10" selected="@(filter.PageSize == 10)">10</option>
                <option value="20" selected="@(filter.PageSize == 20 || filter.PageSize == null)">20</option>
                <option value="50" selected="@(filter.PageSize == 50)">50</option>
                <option value="100" selected="@(filter.PageSize == 100)">100</option>
            </select>

            <nav aria-label="Page navigation">
              <ul class="pagination mb-0">
                <li class="page-item @prevDisabled">
                    <button class="page-link" onclick="changePage(@(Model.PageIndex - 1))">Geri</button>
                </li>
                <li class="page-item disabled"><span class="page-link">Sayfa @Model.PageIndex / @Model.TotalPages</span></li>
                <li class="page-item @nextDisabled">
                    <button class="page-link" onclick="changePage(@(Model.PageIndex + 1))">İleri</button>
                </li>
              </ul>
            </nav>
        </div>
    </div>
</div>

<!-- FLOATING CONTEXTUAL ACTION BAR -->
<div id="contextual-action-bar" class="contextual-action-bar-container">
    <div class="d-flex align-items-center gap-3">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fs-7 fw-bold" id="selected-badge">0 Görevli Seçildi</span>
        
        <div class="h-divider"></div>
        
        <button type="button" class="btn btn-sm btn-success rounded-pill px-3" onclick="triggerBulkExcelQuick()">
            <i class="bi bi-lightning-fill me-1"></i>Hızlı Excel
        </button>
        
        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" onclick="toggleExportPanelFromFloatingBar()">
            <i class="bi bi-gear-fill me-1"></i>Sütun Seç &amp; İndir
        </button>
        
        <button type="button" class="btn btn-sm btn-danger rounded-pill px-3" onclick="executeBulkGorevliDelete()">
            <i class="bi bi-trash-fill me-1"></i>Seçilenleri Güvenli Sil
        </button>
        
        <button type="button" class="btn btn-sm btn-link text-white text-decoration-none ms-2" onclick="clearAllSelections()">
            Sıfırla
        </button>
    </div>
</div>




