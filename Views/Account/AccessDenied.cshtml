@{
    ViewData["Title"] = "Yetki Engellendi";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <i class="bi bi-shield-lock text-danger" style="font-size: 5rem;"></i>
            </div>
            <h1 class="display-5 fw-bold text-dark">Erişim Engellendi</h1>
            <p class="lead text-muted mb-4">
                Bu sayfayı görüntülemek için gerekli yetkiye sahip değilsiniz. Lütfen sistem yöneticinizle iletişime geçin.
            </p>
            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3">
                    <i class="bi bi-house-door me-2"></i>Ana Sayfaya Dön
                </a>
                <a asp-controller="Help" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                    <i class="bi bi-question-circle me-2"></i>Yardım Al
                </a>
            </div>
            
            <div class="mt-5 p-4 bg-light rounded shadow-sm border-start border-danger border-4">
                <h6 class="fw-bold mb-2">Neden bu sayfayı görüyorum?</h6>
                <p class="small text-muted mb-0 text-start">
                    1. Giriş yaptığınız hesap bu modül için tanımlı bir yetkiye (Claim) sahip olmayabilir.<br/>
                    2. Oturum süreniz dolmuş olabilir (Lütfen çıkış yapıp tekrar girmeyi deneyin).<br/>
                    3. Sistemsel bir kısıtlama uygulanmış olabilir.
                </p>
            </div>
        </div>
    </div>
</div>
