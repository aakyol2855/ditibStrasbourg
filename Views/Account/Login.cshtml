@model DitibStasbourg.Models.ViewModels.LoginViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="text-center mb-4">
    <img src="@Configuration["Branding:LogoUrl"]" alt="Logo" class="mb-3" style="max-height: 80px;" onerror="this.style.display='none'" />
    <h2 class="fw-bold text-dark">@Configuration["Branding:AppName"]</h2>
    <p class="text-muted">Lütfen sisteme giriş yapın</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3 text-start">
                <label asp-for="Email" class="control-label">E-posta</label>
                <input asp-for="Email" class="form-control" placeholder="E-posta adresiniz" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-4 text-start">
                <label asp-for="Password" class="control-label">Şifre</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Şifreniz" />
                <span asp-validation-for="Password" class="text-danger"></span>
                <small class="form-text text-muted">İlk girişinizde şifre boş bırakılabilir.</small>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg">Giriş Yap</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
