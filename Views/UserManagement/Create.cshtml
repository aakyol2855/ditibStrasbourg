@{
    ViewData["Title"] = "Yeni Kullanıcı Ekle";
}

<h1>Yeni Kullanıcı Ekle</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label for="email" class="control-label">E-posta</label>
                <input type="email" name="email" class="form-control" required />
            </div>

            <div class="form-group">
                <input type="submit" value="Kullanıcı Oluştur" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
            </div>
            
            <div class="alert alert-info mt-3">
                <strong>Not:</strong> Oluşturulan kullanıcı için şifre atanmayacaktır. Kullanıcı ilk girişinde şifresini kendisi belirleyecektir.
            </div>
        </form>
    </div>
</div>
