@model DitibStasbourg.Models.ViewModels.UserEditViewModel

@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<h1>Kullanıcı Düzenle</h1>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light fw-bold">Kullanıcı Bilgileri ve Roller</div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">Kullanıcı Adı</label>
                        <input asp-for="UserName" class="form-control" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <h5 class="mt-4">Rol Atama</h5>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="IsAdmin">
                        <label class="form-check-label" asp-for="IsAdmin">Admin (Yönetici)</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="IsSuperAdmin">
                        <label class="form-check-label" asp-for="IsSuperAdmin">SuperAdmin (Tam Yetki)</label>
                    </div>

                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Değişiklikleri Kaydet</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </form>            
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white fw-bold">Şifre Sıfırla</div>
            <div class="card-body">
                <p class="text-muted small">Kullanıcının şifresini yönetici olarak sıfırlayabilirsiniz.</p>
                <form asp-action="ResetPassword" method="post">
                    <input type="hidden" name="userId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Yeni Şifre</label>
                        <input type="text" name="newPassword" class="form-control" placeholder="Yeni şifreyi girin..." required />
                    </div>
                    <button type="submit" class="btn btn-danger w-100"><i class="fas fa-key"></i> Şifreyi Sıfırla</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
